relationship Order_Items_Customers
	fromColumn: Order_Items.'Customer ID'
	toColumn: Customers.'Customer ID'

relationship Order_Items_Products
	fromColumn: Order_Items.'Product ID'
	toColumn: Products.'Product ID'

relationship Order_Items_Date
	fromColumn: Order_Items.'Order Date'
	toColumn: Date.Date

relationship Forecast_Scenario
	fromColumn: Forecast.Scenario
	toColumn: Scenario.Scenario

relationship Forecast2026_Scenario
	fromColumn: 'Forecast 2026'.Scenario
	toColumn: Scenario.Scenario

