model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ProjectFolder","SourceWorkbook","ProductsRef","Customers","Products","Order_Items","Forecast","Forecast 2026","Levers"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customers
ref table Products
ref table Order_Items
ref table Date
ref table _Measures
ref table Forecast
ref table 'Forecast 2026'
ref table Levers
ref table Scenario
ref table 'Refresh Info'

ref cultureInfo en-IN

