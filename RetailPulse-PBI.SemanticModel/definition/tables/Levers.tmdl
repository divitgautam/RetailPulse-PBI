/// Four 2026 profit levers with low/mid/high uplift, confidence and cost. From analysis/output/pbi_levers.csv: re-run the notebooks, then refresh.
table Levers
	lineageTag: f8e2e241-eb90-4c97-81f3-409340bd5bdb

	/// Profit lever.
	column Lever
		dataType: string
		lineageTag: 5143ceb9-6694-44a3-a9a1-ea3c7e15f802
		summarizeBy: none
		sourceColumn: Lever

		annotation SummarizationSetBy = User

	/// Confidence in the sizing.
	column Confidence
		dataType: string
		lineageTag: e97c0928-972e-4d30-abff-c4e84b811caf
		summarizeBy: none
		sourceColumn: Confidence

		annotation SummarizationSetBy = User

	/// Cost to run the lever.
	column Cost
		dataType: string
		lineageTag: 0ae45506-1e41-4391-a4be-b2c7e9cae16e
		summarizeBy: none
		sourceColumn: Cost

		annotation SummarizationSetBy = User

	/// How the lever was sized.
	column Basis
		dataType: string
		lineageTag: e3a4d906-fe22-4b14-bf3b-eb2b7fe4f750
		summarizeBy: none
		sourceColumn: Basis

		annotation SummarizationSetBy = User

	/// Low estimate of extra 2026 gross profit, in rupees.
	column 'Uplift Low'
		dataType: decimal
		formatString: ₹#,##0
		lineageTag: 9e1435d4-2e00-4c5b-a44d-833384b542cc
		summarizeBy: none
		sourceColumn: Uplift Low

		annotation SummarizationSetBy = User

	/// High estimate of extra 2026 gross profit, in rupees.
	column 'Uplift High'
		dataType: decimal
		formatString: ₹#,##0
		lineageTag: 00fa0f5f-c144-49c7-a2bb-9f51f20e5a81
		summarizeBy: none
		sourceColumn: Uplift High

		annotation SummarizationSetBy = User

	/// Mid estimate of extra 2026 gross profit, in rupees.
	column 'Uplift Mid'
		dataType: decimal
		formatString: ₹#,##0
		lineageTag: 44feb234-5412-4be8-8a23-22c64fa3713f
		summarizeBy: none
		sourceColumn: Uplift Mid

		annotation SummarizationSetBy = User

	partition Levers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_levers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Promoted,
				    Typed = Table.TransformColumnTypes(Blanks, {{"lever", type text}, {"uplift_low", Currency.Type}, {"uplift_high", Currency.Type}, {"confidence", type text}, {"cost", type text}, {"basis", type text}, {"uplift_mid", Currency.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"lever", "Lever"}, {"uplift_low", "Uplift Low"}, {"uplift_high", "Uplift High"}, {"confidence", "Confidence"}, {"cost", "Cost"}, {"basis", "Basis"}, {"uplift_mid", "Uplift Mid"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["ENSURE_TABLES_HAVE_RELATIONSHIPS"]}

