	partition Forecast = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_forecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Blanks to null" = Table.ReplaceValue(#"Promoted headers", "", null, Replacer.ReplaceValue, {"actual", "p10", "p50", "p90"}),
				  #"Changed column type" = Table.TransformColumnTypes(#"Blanks to null", {{"scenario", type text}, {"month", type date}, {"metric", type text}, {"kind", type text}, {"actual", type number}, {"p10", type number}, {"p50", type number}, {"p90", type number}}, "en-US")
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

