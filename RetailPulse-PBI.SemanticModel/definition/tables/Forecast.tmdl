/// Monthly history (Jan 2023-Oct 2025) and simulated forecast (Nov 2025-Dec 2026) by scenario and metric. From analysis/output/pbi_forecast.csv: re-run the notebooks, then refresh.
table Forecast
	lineageTag: 14a3344b-f9ec-406f-9e3e-a667949305a4

	/// Acquisition scenario (relates to Scenario).
	column Scenario
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 452b3bb6-8018-48f2-abf2-832822256ce5
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = User

	/// Month of the history or forecast value.
	column Month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 99a16135-1f40-4bb3-9946-1553ca1a64d4
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = User

	/// Gross profit, Net sales, Revenue orders or New buyers.
	column Metric
		dataType: string
		lineageTag: c0d4d6dd-2798-4e86-9d26-1ce182efa81e
		summarizeBy: none
		sourceColumn: Metric

		annotation SummarizationSetBy = User

	/// Actual or Forecast row.
	column Kind
		dataType: string
		lineageTag: 4be2a84d-de1d-4253-81ef-75d2ef1cbf38
		summarizeBy: none
		sourceColumn: Kind

		annotation SummarizationSetBy = User

	/// Actual monthly value (history rows).
	column Actual
		dataType: decimal
		formatString: #,##0
		lineageTag: 6cc7044c-2046-4b0c-8f42-9d803055e604
		summarizeBy: none
		sourceColumn: Actual

		annotation SummarizationSetBy = User

	/// Forecast low case (10th percentile of 2,000 runs).
	column P10
		dataType: decimal
		formatString: #,##0
		lineageTag: 2b03a608-7d05-42e7-9d39-8f32ac8e2fb8
		summarizeBy: none
		sourceColumn: P10

		annotation SummarizationSetBy = User

	/// Forecast median.
	column P50
		dataType: decimal
		formatString: #,##0
		lineageTag: 5bc8bbeb-d06e-40f4-8440-56f4e89b5fd5
		summarizeBy: none
		sourceColumn: P50

		annotation SummarizationSetBy = User

	/// Forecast high case (90th percentile).
	column P90
		dataType: decimal
		formatString: #,##0
		lineageTag: 3e67d246-dbbe-49d7-b8e3-09ebeae6c3ad
		summarizeBy: none
		sourceColumn: P90

		annotation SummarizationSetBy = User

	partition Forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_forecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"actual", "p10", "p50", "p90"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"scenario", type text}, {"month", type date}, {"metric", type text}, {"kind", type text}, {"actual", Currency.Type}, {"p10", Currency.Type}, {"p50", Currency.Type}, {"p90", Currency.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"scenario", "Scenario"}, {"month", "Month"}, {"metric", "Metric"}, {"kind", "Kind"}, {"actual", "Actual"}, {"p10", "P10"}, {"p50", "P50"}, {"p90", "P90"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

