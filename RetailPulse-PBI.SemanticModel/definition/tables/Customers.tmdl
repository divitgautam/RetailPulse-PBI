/// Customer dimension: 300 customers after removing duplicate and stub rows.
table Customers
	lineageTag: d6471d88-86ac-4b80-9703-655dedaf8921

	/// Customer city.
	column City
		dataType: string
		lineageTag: 4bed9f97-496e-4b6f-873d-3c4009eba2a9
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = User

	/// Customer state.
	column State
		dataType: string
		lineageTag: f7e06ac2-e471-452d-925c-58cfc8b3c08e
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = User

	/// Customer country (all India).
	column Country
		dataType: string
		lineageTag: 425c4d0d-5947-4e29-80a6-6d5a12394279
		dataCategory: Country
		summarizeBy: none
		sourceColumn: Country

		annotation SummarizationSetBy = User

	/// Retail or Wholesale.
	column Segment
		dataType: string
		lineageTag: 513a574b-720b-4440-8c68-1af69adfee89
		summarizeBy: none
		sourceColumn: Segment

		annotation SummarizationSetBy = User

	/// Gender as recorded.
	column Gender
		dataType: string
		lineageTag: a07efa77-0d02-4748-a5e1-dad2fa6defb2
		summarizeBy: none
		sourceColumn: Gender

		annotation SummarizationSetBy = User

	/// Orders ever placed, any status (0 = registered but never ordered).
	column 'Lifetime Orders' = CALCULATE ( DISTINCTCOUNT ( Order_Items[Order ID] ) ) + 0
		dataType: int64
		formatString: 0
		displayFolder: Customer Behaviour
		lineageTag: 1d979801-cea7-4651-9a0e-8bd86f96e0c8
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// No Purchase (0 orders), One-Time (1) or Recurring (2+), over the customer's lifetime.
	column 'Customer Type' = SWITCH ( TRUE (), Customers[Lifetime Orders] = 0, "No Purchase", Customers[Lifetime Orders] = 1, "One-Time", "Recurring" )
		dataType: string
		displayFolder: Customer Behaviour
		lineageTag: c56cd694-dbdd-429c-8939-e3800bf30769
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Lifetime order count as a band: 0, 1, 2, 3 or 4+ orders.
	column 'Order Frequency' = SWITCH ( TRUE (), Customers[Lifetime Orders] = 0, "0 orders", Customers[Lifetime Orders] = 1, "1 order", Customers[Lifetime Orders] = 2, "2 orders", Customers[Lifetime Orders] = 3, "3 orders", "4+ orders" )
		dataType: string
		displayFolder: Customer Behaviour
		lineageTag: 4a1ad97a-47c3-4784-8566-66f0f848c68b
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Gross profit from the customer's revenue orders.
	column 'Lifetime Gross Profit' = CALCULATE ( SUM ( Order_Items[Gross Profit] ), Order_Items[Is Revenue Order] = TRUE () )
		dataType: decimal
		formatString: ₹#,##0
		displayFolder: Customer Behaviour
		lineageTag: 42ee3b3d-be52-44f4-a20d-34b957de4a03
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Date of the customer's latest order (any status).
	column 'Last Order Date' = CALCULATE ( MAX ( Order_Items[Order Date] ) )
		dataType: dateTime
		formatString: dd-mmm-yyyy
		displayFolder: Customer Behaviour
		lineageTag: 53706b63-81af-4b9d-93a3-366496ae7f26
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Age band on 31 Oct 2025 (the last order date).
	column 'Age Group' = VAR a = DATEDIFF ( Customers[Birth Date], DATE ( 2025, 10, 31 ), YEAR ) RETURN SWITCH ( TRUE (), ISBLANK ( Customers[Birth Date] ), "Unknown", a < 25, "18-24", a < 35, "25-34", a < 45, "35-44", a < 55, "45-54", "55+" )
		dataType: string
		displayFolder: Customer Behaviour
		lineageTag: f764918c-2cc1-46c5-b4da-3a1c509e95eb
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Customer identifier (key). Duplicates in the source are collapsed to the most complete row.
	column 'Customer ID'
		dataType: string
		isKey
		lineageTag: 294ff35d-5519-4011-a264-67cebd7bd65b
		summarizeBy: none
		sourceColumn: Customer ID

		annotation SummarizationSetBy = User

	/// Date the customer registered. The last sign-up is 25 Sep 2024.
	column 'Join Date'
		dataType: dateTime
		formatString: dd-mmm-yyyy
		lineageTag: 91ea5757-f385-4a0d-8de9-f63f8591c3d7
		summarizeBy: none
		sourceColumn: Join Date

		annotation SummarizationSetBy = User

	/// Date of birth (feeds Age Group).
	column 'Birth Date'
		dataType: dateTime
		formatString: dd-mmm-yyyy
		lineageTag: 703daf4d-fca4-4d40-b852-1c060b205319
		summarizeBy: none
		sourceColumn: Birth Date

		annotation SummarizationSetBy = User

	/// Date of the customer's first order (any status).
	column 'First Order Date' = CALCULATE ( MIN ( Order_Items[Order Date] ) )
		dataType: dateTime
		formatString: dd-mmm-yyyy
		displayFolder: Customer Behaviour
		lineageTag: bf37191a-2345-4064-b283-b980e9e12942
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition Customers = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(SourceWorkbook), null, true),
				    Sheet = Source{[Item = "Customers", Kind = "Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"customer_id", type text}, {"first_name", type text}, {"last_name", type text}, {"email", type text}, {"phone", Int64.Type}, {"join_date", type date}, {"city", type text}, {"state", type text}, {"country", type text}, {"segment", type text}, {"gender", type text}, {"birth_date", type date}}, "en-US"),
				    NoBlankIds = Table.SelectRows(Typed, each [customer_id] <> null and [customer_id] <> ""),
				    Completeness = Table.AddColumn(NoBlankIds, "__filled", each List.NonNullCount(Record.FieldValues(_)), Int64.Type),
				    Sorted = Table.Buffer(Table.Sort(Completeness, {{"customer_id", Order.Ascending}, {"__filled", Order.Descending}})),
				    MostComplete = Table.Distinct(Sorted, {"customer_id"}),
				    NoStubs = Table.SelectRows(MostComplete, each not ([email] = null and [join_date] = null and [segment] = null)),
				    NoPersonalData = Table.RemoveColumns(NoStubs, {"__filled", "first_name", "last_name", "email", "phone"}),
				    Renamed = Table.RenameColumns(NoPersonalData, {{"customer_id", "Customer ID"}, {"join_date", "Join Date"}, {"city", "City"}, {"state", "State"}, {"country", "Country"}, {"segment", "Segment"}, {"gender", "Gender"}, {"birth_date", "Birth Date"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

