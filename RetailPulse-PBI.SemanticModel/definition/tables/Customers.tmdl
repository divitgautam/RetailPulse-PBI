	column 'Lifetime Orders' = CALCULATE ( DISTINCTCOUNT ( Order_Items[order_id] ) ) + 0
		dataType: int64
		formatString: 0
		displayFolder: Customer Behaviour
		lineageTag: 1ee98db2-2eaf-479c-8a5a-68955acd64c0

	column 'Customer Type' = SWITCH ( TRUE (), Customers[Lifetime Orders] = 0, "No Purchase", Customers[Lifetime Orders] = 1, "One-Time", "Recurring" )
		dataType: string
		displayFolder: Customer Behaviour
		lineageTag: 5503c7e9-9ee8-46fc-9873-50b4b59d57be

	column 'Order Frequency' = SWITCH ( TRUE (), Customers[Lifetime Orders] = 0, "0 orders", Customers[Lifetime Orders] = 1, "1 order", Customers[Lifetime Orders] = 2, "2 orders", Customers[Lifetime Orders] = 3, "3 orders", "4+ orders" )
		dataType: string
		displayFolder: Customer Behaviour
		lineageTag: 58769e79-879f-44ed-b9da-e76c567d2d4b

	column 'Lifetime Gross Profit' = CALCULATE ( SUM ( Order_Items[Gross Profit] ), Order_Items[Is Revenue Order] = TRUE () )
		dataType: double
		formatString: #,##0
		displayFolder: Customer Behaviour
		lineageTag: 18b1b404-d0b0-4e88-b3e9-7831cdbb666f

	column 'Last Order Date' = CALCULATE ( MAX ( Order_Items[order_date] ) )
		dataType: dateTime
		formatString: dd-mmm-yyyy
		displayFolder: Customer Behaviour
		lineageTag: d38f5ee4-937d-4807-aedc-b1f4cf20bf4f

	column 'Age Group' = VAR a = IF ( ISBLANK ( Customers[birth_date] ), BLANK (), DATEDIFF ( Customers[birth_date], DATE ( 2025, 10, 31 ), YEAR ) ) RETURN SWITCH ( TRUE (), ISBLANK ( a ), "Unknown", a < 25, "18-24", a < 35, "25-34", a < 45, "35-44", a < 55, "45-54", "55+" )
		dataType: string
		displayFolder: Customer Behaviour
		lineageTag: 195803d8-17cc-44a6-8e62-5dde3718f4d4

	partition 'Customers Deduped' = m
		mode: import
		source = let Source = Excel.Workbook(File.Contents("C:\Users\hp\Downloads\Online Sales Data.xlsx"), null, true), #"Navigation 1" = Source{[Item = "Customers", Kind = "Sheet"]}[Data], #"Promoted headers" = Table.PromoteHeaders(#"Navigation 1", [PromoteAllScalars = true]), #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"customer_id", type text}, {"first_name", type text}, {"last_name", type text}, {"email", type text}, {"phone", Int64.Type}, {"join_date", type date}, {"city", type text}, {"state", type text}, {"country", type text}, {"segment", type text}, {"gender", type text}, {"birth_date", type date}}, "en-US"), #"Removed blank IDs" = Table.SelectRows(#"Changed column type", each [customer_id] <> null and [customer_id] <> ""), #"Added completeness" = Table.AddColumn(#"Removed blank IDs", "__filled", each List.NonNullCount(Record.FieldValues(_)), Int64.Type), #"Sorted by completeness" = Table.Buffer(Table.Sort(#"Added completeness", {{"customer_id", Order.Ascending}, {"__filled", Order.Descending}})), #"Kept most complete row" = Table.Distinct(#"Sorted by completeness", {"customer_id"}), #"Removed helper" = Table.RemoveColumns(#"Kept most complete row", {"__filled"}), #"Removed stub rows" = Table.SelectRows(#"Removed helper", each not ([email] = null and [join_date] = null and [segment] = null)) in #"Removed stub rows"

	annotation PBI_ResultType = Table

