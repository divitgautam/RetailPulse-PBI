table Customers
	lineageTag: 5ee2e538-482a-43cf-935b-880d62306357

	measure 'One-Time Customers' =
			
			COALESCE (
			    COUNTROWS (
			        FILTER (
			            VALUES ( Customers[customer_id] ),
			            NOT ISBLANK ( Customers[customer_id] )
			                && [Total Orders] = 1
			        )
			    ),
			    0
			)
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: d2bf6d5b-c7c6-4d3f-bbab-75e41b26742b

	measure 'Recurring Customers' =
			
			COALESCE (
			    COUNTROWS (
			        FILTER (
			            VALUES ( Customers[customer_id] ),
			            NOT ISBLANK ( Customers[customer_id] )
			                && [Total Orders] >= 2
			        )
			    ),
			    0
			)
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: 835103d4-d406-4594-ba7d-22b022ea8f20

	measure 'Purchasing Customers' =
			
			[One-Time Customers] + [Recurring Customers]
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: bcf1eac0-13c6-4149-ab49-d935fa337c9b

	measure 'Recurring Customer %' =
			
			DIVIDE (
			    [Recurring Customers],
			    [Purchasing Customers],
			    0
			)
		formatString: 0.0%
		displayFolder: 3 Customers
		lineageTag: c8b7e187-b15a-492d-9d03-118bbfaa2405

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'One-Time Customer %' =
			
			DIVIDE (
			    [One-Time Customers],
			    [Purchasing Customers],
			    0
			)
		formatString: 0.0%
		displayFolder: 3 Customers
		lineageTag: f15e617b-ca97-4c12-b0fc-0885d3062ac3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

