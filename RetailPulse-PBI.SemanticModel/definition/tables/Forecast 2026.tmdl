/// 2026 totals by scenario: orders, sales, profit, new buyers, PPAC and the chance of hitting the PPAC target. From analysis/output/pbi_forecast_2026.csv: re-run the notebooks, then refresh.
table 'Forecast 2026'
	lineageTag: fb40f75f-e4bc-4027-8217-28628be9bf55

	/// Acquisition scenario (relates to Scenario).
	column Scenario
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 42d19fa1-a6f1-485e-b18d-ccaec80db229
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = User

	/// 2026 total being forecast.
	column Metric
		dataType: string
		lineageTag: 978aa426-1656-4e3e-905e-150da4b4ee5a
		summarizeBy: none
		sourceColumn: Metric

		annotation SummarizationSetBy = User

	/// Low case (10th percentile).
	column P10
		dataType: decimal
		formatString: #,##0.##
		lineageTag: 45b39de2-cb36-48dd-9dee-b6b023901c74
		summarizeBy: none
		sourceColumn: P10

		annotation SummarizationSetBy = User

	/// Median.
	column P50
		dataType: decimal
		formatString: #,##0.##
		lineageTag: 076926ce-07bf-41f8-befd-f38c640c648a
		summarizeBy: none
		sourceColumn: P50

		annotation SummarizationSetBy = User

	/// High case (90th percentile).
	column P90
		dataType: decimal
		formatString: #,##0.##
		lineageTag: 1af44233-115d-42e2-90e2-1185f26d3bd5
		summarizeBy: none
		sourceColumn: P90

		annotation SummarizationSetBy = User

	partition 'Forecast 2026' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\analysis\output\pbi_forecast_2026.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Promoted,
				    Typed = Table.TransformColumnTypes(Blanks, {{"scenario", type text}, {"metric", type text}, {"p10", Currency.Type}, {"p50", Currency.Type}, {"p90", Currency.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"scenario", "Scenario"}, {"metric", "Metric"}, {"p10", "P10"}, {"p50", "P50"}, {"p90", "P90"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

