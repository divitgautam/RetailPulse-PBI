	/// Lifetime orders per buying customer, for cards.
	measure 'Card Avg Orders' = FORMAT ( [Avg Orders per Customer], "0.00" )
		displayFolder: 6 Display
		lineageTag: deed0a2e-47b6-4ffe-9fc0-42f74ed7f0f7

	/// Registered customers who never ordered, for cards.
	measure 'Card Never Ordered' = FORMAT ( [Never-Purchased Customers], "#,##0" )
