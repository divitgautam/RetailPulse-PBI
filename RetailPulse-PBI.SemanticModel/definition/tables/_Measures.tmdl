/// Central home for report measures, in display folders 1-7.
table _Measures
	lineageTag: 31417963-eb9b-4f37-91fd-8fc699df0ace

	/// Revenue excluding tax and shipping, after item and order discounts. Excludes cancelled and returned orders.
	measure 'Net Sales' = CALCULATE ( SUM ( Order_Items[Net Sales] ), Order_Items[Is Revenue Order] = TRUE () )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 0f0b351c-fef5-446a-bddd-6c122a722003

	/// Unit price x quantity before any discount. Excludes cancelled and returned orders.
	measure 'Gross Sales (List Price)' = CALCULATE ( SUM ( Order_Items[Gross Amount] ), Order_Items[Is Revenue Order] = TRUE () )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 5c8c7896-8015-4460-9983-4e23f31bbeb9

	/// Product cost price x quantity for revenue orders.
	measure COGS = CALCULATE ( SUM ( Order_Items[COGS] ), Order_Items[Is Revenue Order] = TRUE () )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 63056cb6-61da-48cd-b1ec-f1a351352ce6

	/// Net Sales minus COGS for revenue orders.
	measure 'Gross Profit' = CALCULATE ( SUM ( Order_Items[Gross Profit] ), Order_Items[Is Revenue Order] = TRUE () )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 7527575b-3017-427a-b22c-3bee5f023c74

	/// Gross Profit / Net Sales.
	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Net Sales] )
		formatString: 0.0%
		displayFolder: 1 Sales & Profit
		lineageTag: 26a1936f-3926-4929-adab-1774ba1ae8f4

	/// Value given away through item and order discounts.
	measure 'Discount Amount' = [Gross Sales (List Price)] - [Net Sales]
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: e2843f9b-2ed2-4b53-af0a-a40e312cb126

	/// Discount Amount / Gross Sales at list price.
	measure 'Discount Rate %' = DIVIDE ( [Discount Amount], [Gross Sales (List Price)] )
		formatString: 0.0%
		displayFolder: 1 Sales & Profit
		lineageTag: fe0d3836-c128-454c-98fe-db078f9de9c4

	/// Units on revenue orders.
	measure 'Units Sold' = CALCULATE ( SUM ( Order_Items[Quantity] ), Order_Items[Is Revenue Order] = TRUE () )
		formatString: #,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 730b479b-358b-4059-bac5-bd57d820dc50

	/// Orders that are not cancelled or returned.
	measure 'Revenue Orders' = CALCULATE ( DISTINCTCOUNT ( Order_Items[Order ID] ), Order_Items[Is Revenue Order] = TRUE () )
		formatString: #,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 9a548d07-6849-4c5a-a23d-18049c184069

	/// Net Sales per revenue order.
	measure 'Avg Order Value' = DIVIDE ( [Net Sales], [Revenue Orders] )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: a75c3c83-14ac-47f6-901b-5a1b70f9f735

	/// Gross Profit per revenue order.
	measure 'Profit per Order' = DIVIDE ( [Gross Profit], [Revenue Orders] )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: dfd753b0-9542-457f-b6aa-c75a75fdca94

	/// Net Sales on cancelled or returned orders.
	measure 'Lost Net Sales' = CALCULATE ( SUM ( Order_Items[Net Sales] ), Order_Items[Is Revenue Order] = FALSE () )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: a0aba7ba-00a6-4500-a776-ea0dff67b39e

	/// Gross Profit forgone on cancelled or returned orders.
	measure 'Lost Gross Profit' = CALCULATE ( SUM ( Order_Items[Gross Profit] ), Order_Items[Is Revenue Order] = FALSE () )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 0568322d-6313-47b5-95fb-7e65fa046ce3

	/// Share of placed orders that were cancelled or returned.
	measure 'Cancel & Return Rate %' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( Order_Items[Order ID] ), Order_Items[Is Revenue Order] = FALSE () ), [Total Orders] )
		formatString: 0.0%
		displayFolder: 1 Sales & Profit
		lineageTag: 89cd5cb9-542c-4204-8a94-84a2236e7dec

	/// Order lines sold below cost after discounts.
	measure 'Loss-Making Lines' = CALCULATE ( COUNTROWS ( Order_Items ), Order_Items[Is Revenue Order] = TRUE (), Order_Items[Gross Profit] < 0 )
		formatString: #,##0
		displayFolder: 1 Sales & Profit
		lineageTag: b713b2ef-c6fa-4497-9a71-b4e2c71a44a7

	/// Total negative profit on lines sold below cost.
	measure 'Profit Lost on Loss-Making Lines' = CALCULATE ( SUM ( Order_Items[Gross Profit] ), Order_Items[Is Revenue Order] = TRUE (), Order_Items[Gross Profit] < 0 )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 732a66bb-81d7-4907-b2e8-de28c8700fc8

	/// Gross Profit for the same period last year.
	measure 'Gross Profit PY' = CALCULATE ( [Gross Profit], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: d76c7595-aff6-4362-b1b8-d748870002c9

	/// Year-over-year change in Gross Profit (one year selected).
	measure 'Gross Profit YoY %' = IF ( HASONEVALUE ( 'Date'[Year] ), DIVIDE ( [Gross Profit] - [Gross Profit PY], [Gross Profit PY] ) )
		formatString: 0.0%
		displayFolder: 1 Sales & Profit
		lineageTag: f20ad672-47d3-4a2b-8e80-cb6d68649596

	/// Gross Profit as a share of all products (keeps year and segment filters).
	measure 'Category Profit Share %' = DIVIDE ( [Gross Profit], CALCULATE ( [Gross Profit], REMOVEFILTERS ( Products ) ) )
		formatString: 0.0%
		displayFolder: 2 Category
		lineageTag: 74c92001-4779-47af-b706-0660db15eca3

	/// Rank of the category by Gross Profit.
	measure 'Category Profit Rank' = IF ( NOT ISBLANK ( [Gross Profit] ), RANKX ( ALLSELECTED ( Products[Category] ), [Gross Profit], , DESC, DENSE ) )
		formatString: 0
		displayFolder: 2 Category
		lineageTag: 82b8294e-f395-4acc-8e22-210f382e7447

	/// Margin minus the margin of all products, in percentage points.
	measure 'Margin vs Avg (pp)' = VAR m = [Gross Margin %] VAR avgm = CALCULATE ( [Gross Margin %], REMOVEFILTERS ( Products ) ) RETURN IF ( NOT ISBLANK ( m ), ( m - avgm ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 2 Category
		lineageTag: e0275afb-eeef-46f9-8f71-af00ded39cae

	/// Category with the highest Gross Profit.
	measure 'Top Profit Category' = CONCATENATEX ( TOPN ( 1, ALLSELECTED ( Products[Category] ), [Gross Profit], DESC ), Products[Category], ", " )
		displayFolder: 2 Category
		lineageTag: 0b974b32-a1b1-4fdb-8cbc-0b0b525ab06b

	/// Category with the lowest Gross Profit.
	measure 'Lowest Profit Category' = CONCATENATEX ( TOPN ( 1, FILTER ( ALLSELECTED ( Products[Category] ), NOT ISBLANK ( [Gross Profit] ) ), [Gross Profit], ASC ), Products[Category], ", " )
		displayFolder: 2 Category
		lineageTag: e4b9023f-4f12-4167-8a13-f4e5c092bf48

	/// All customers in the customer master.
	measure 'Registered Customers' = COUNTROWS ( Customers )
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: 949c4066-eee2-491c-9b09-60a538f9e76b

	/// Registered customers with no order ever.
	measure 'Never-Purchased Customers' = CALCULATE ( COUNTROWS ( Customers ), Customers[Customer Type] = "No Purchase" )
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: ecec3aa0-c791-4eee-8fa7-fa0f9d4ed394

	/// Share of registered customers who have placed at least one order.
	measure 'Customer Activation Rate %' = DIVIDE ( [Purchasing Customers], [Registered Customers] )
		formatString: 0.0%
		displayFolder: 3 Customers
		lineageTag: ee30f070-2a9f-4a3f-be60-c6e7dfd4bb8f

	/// Lifetime orders (any status) per buying customer.
	measure 'Avg Orders per Customer' = DIVIDE ( [Total Orders], [Purchasing Customers] )
		formatString: 0.00
		displayFolder: 3 Customers
		lineageTag: 21c741b0-4545-4049-be2a-2e7009ae3858

	/// Gross Profit from customers with 2+ lifetime orders.
	measure 'Recurring Customer Profit' = CALCULATE ( [Gross Profit], Customers[Customer Type] = "Recurring" )
		formatString: ₹#,##0
		displayFolder: 3 Customers
		lineageTag: 679a51a7-a05d-4026-9244-987d4c613f85

	/// Gross Profit from customers with exactly one lifetime order.
	measure 'One-Time Customer Profit' = CALCULATE ( [Gross Profit], Customers[Customer Type] = "One-Time" )
		formatString: ₹#,##0
		displayFolder: 3 Customers
		lineageTag: 4e07dc84-d90a-4af5-9437-2c2f3dfef328

	/// Share of Gross Profit generated by recurring customers.
	measure 'Recurring Profit Share %' = DIVIDE ( [Recurring Customer Profit], [Gross Profit] )
		formatString: 0.0%
		displayFolder: 3 Customers
		lineageTag: ab5e6368-090f-403d-a1e2-ebc86517fe29

	/// Gross Profit per recurring customer.
	measure 'Profit per Recurring Customer' = DIVIDE ( [Recurring Customer Profit], CALCULATE ( [Active Customers], Customers[Customer Type] = "Recurring" ) )
		formatString: ₹#,##0
		displayFolder: 3 Customers
		lineageTag: beb1f7a9-1447-47b3-bbef-72fb72fca1bb

	/// Gross Profit per one-time customer.
	measure 'Profit per One-Time Customer' = DIVIDE ( [One-Time Customer Profit], CALCULATE ( [Active Customers], Customers[Customer Type] = "One-Time" ) )
		formatString: ₹#,##0
		displayFolder: 3 Customers
		lineageTag: feb361f1-c9fb-4d7b-b540-ab59f53f38ed

	/// How many times more profit a recurring customer brings than a one-time customer.
	measure 'Recurring Value Multiplier' = DIVIDE ( [Profit per Recurring Customer], [Profit per One-Time Customer] )
		formatString: 0.0"x"
		displayFolder: 3 Customers
		lineageTag: 462b308f-0f1a-4cf2-9a39-4eae20b53b2f

	/// Customers with at least one revenue order in the period.
	measure 'Active Customers' = CALCULATE ( DISTINCTCOUNT ( Order_Items[Customer ID] ), Order_Items[Is Revenue Order] = TRUE () )
		formatString: #,##0
		displayFolder: 4 KPI
		lineageTag: bf4c5979-72a0-4ff2-b1a4-29b988e99dbd

	/// Purchase frequency: revenue orders per active customer.
	measure 'Orders per Active Customer' = DIVIDE ( [Revenue Orders], [Active Customers] )
		formatString: 0.00
		displayFolder: 4 KPI
		lineageTag: a55d1bf1-e653-4076-a510-45c0026374e7

	/// HEADLINE KPI (PPAC). Gross Profit per active customer = Orders per Customer x Avg Order Value x Gross Margin %.
	measure 'Profit per Active Customer' = DIVIDE ( [Gross Profit], [Active Customers] )
		formatString: ₹#,##0
		displayFolder: 4 KPI
		lineageTag: 21fee27c-fabe-452f-9ffd-d39ee5ba5884

	/// PPAC for the same period last year.
	measure 'Profit per Active Customer PY' = CALCULATE ( [Profit per Active Customer], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: ₹#,##0
		displayFolder: 4 KPI
		lineageTag: 199733b1-7b40-4e9f-87cf-9a4de8d76d25

	/// Assumed growth target over last year. Edit this value to change the target.
	measure 'KPI Target Growth %' = 0.05
		formatString: 0.0%
		displayFolder: 4 KPI
		lineageTag: 7db1c9d6-5be2-424a-819c-baa9dce50a9d

	/// Last year's PPAC plus the target growth.
	measure 'Profit per Active Customer Target' = [Profit per Active Customer PY] * ( 1 + [KPI Target Growth %] )
		formatString: ₹#,##0
		displayFolder: 4 KPI
		lineageTag: b9a4b8a2-2655-4f56-b9a6-3edc87961e99

	/// Year-over-year change in PPAC (one year selected).
	measure 'Profit per Active Customer YoY %' = IF ( HASONEVALUE ( 'Date'[Year] ), DIVIDE ( [Profit per Active Customer] - [Profit per Active Customer PY], [Profit per Active Customer PY] ) )
		formatString: 0.0%
		displayFolder: 4 KPI
		lineageTag: 3ab01690-0b0b-4291-8893-a6c09606ec55

	/// PPAC versus target.
	measure 'KPI vs Target %' = DIVIDE ( [Profit per Active Customer] - [Profit per Active Customer Target], [Profit per Active Customer Target] )
		formatString: 0.0%
		displayFolder: 4 KPI
		lineageTag: d69d2539-a8b0-4508-ae6d-178ea8046648

	/// Traffic-light status of PPAC: on target, watch (within 5%), below.
	measure 'KPI Status' = VAR v = [Profit per Active Customer] VAR t = [Profit per Active Customer Target] RETURN SWITCH ( TRUE (), NOT HASONEVALUE ( 'Date'[Year] ), "Pick a year", ISBLANK ( t ), "No target", v >= t, "On target", v >= t * 0.95, "Watch", "Below" )
		displayFolder: 4 KPI
		lineageTag: 6803a3d8-29a1-479b-b6a4-bb13cdea4f17

	/// Colour for the PPAC status: green on target, amber within 5%, red below (AA contrast).
	measure 'KPI Status Color' = VAR v = [Profit per Active Customer] VAR t = [Profit per Active Customer Target] RETURN SWITCH ( TRUE (), ISBLANK ( t ), "#5B6B7F", v >= t, "#1E7F4B", v >= t * 0.95, "#A15F00", "#C0392B" )
		displayFolder: 4 KPI
		lineageTag: de743567-72e9-4f84-b2e6-84bf2d8f7322

	/// Share of active customers with 2+ revenue orders in the period.
	measure 'Repeat Purchase Rate %' = DIVIDE ( COUNTROWS ( FILTER ( VALUES ( Order_Items[Customer ID] ), CALCULATE ( DISTINCTCOUNT ( Order_Items[Order ID] ), Order_Items[Is Revenue Order] = TRUE () ) >= 2 ) ), [Active Customers] )
		formatString: 0.0%
		displayFolder: 4 KPI
		lineageTag: d383a718-1711-49d7-9e6d-82195cdeac34

	/// Orders per active customer, same period last year.
	measure 'Orders per Active Customer PY' = CALCULATE ( [Orders per Active Customer], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.00
		displayFolder: 4 KPI
		lineageTag: 3eb3fe2f-f8ba-4fc5-a3f6-4c4414828b4b

	/// Average order value, same period last year.
	measure 'Avg Order Value PY' = CALCULATE ( [Avg Order Value], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: ₹#,##0
		displayFolder: 4 KPI
		lineageTag: 29987e45-8d1b-44f9-b2fc-daa5df2ee925

	/// Gross margin for the same period last year.
	measure 'Gross Margin % PY' = CALCULATE ( [Gross Margin %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.0%
		displayFolder: 1 Sales & Profit
		lineageTag: 5f654715-caec-4cd0-8382-38242020e3fc

	/// Active customers, same period last year.
	measure 'Active Customers PY' = CALCULATE ( [Active Customers], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: #,##0
		displayFolder: 4 KPI
		lineageTag: 3e576ddd-2d7a-4f29-923f-c782105b4fa1

	/// History for the forecast chart: ₹ L for profit and sales, counts otherwise (defaults: scenario A, Gross profit).
	measure 'Fcst Actual' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) VAR mt = SELECTEDVALUE ( Forecast[Metric], "Gross profit" ) RETURN DIVIDE ( CALCULATE ( SUM ( Forecast[Actual] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ), IF ( mt IN { "Gross profit", "Net sales" }, 100000, 1 ) )
		formatString: #,##0.0
		displayFolder: 5 Forecast
		lineageTag: 83f2d6c6-cb43-4159-856f-2d58771b98c6

	/// Forecast median, in chart units.
	measure 'Fcst P50' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) VAR mt = SELECTEDVALUE ( Forecast[Metric], "Gross profit" ) VAR v = CALCULATE ( SUM ( Forecast[P50] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ) VAR lastA = CALCULATE ( MAX ( Forecast[Month] ), REMOVEFILTERS ( Forecast[Month] ), NOT ISBLANK ( Forecast[Actual] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ) RETURN DIVIDE ( IF ( ISBLANK ( v ) && MAX ( Forecast[Month] ) = lastA, CALCULATE ( SUM ( Forecast[Actual] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ), v ), IF ( mt IN { "Gross profit", "Net sales" }, 100000, 1 ) )
		formatString: #,##0.0
		displayFolder: 5 Forecast
		lineageTag: fcaefc53-c52b-4ac8-ace9-a814dde26d32

	/// Forecast low case (P10), in chart units.
	measure 'Fcst P10' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) VAR mt = SELECTEDVALUE ( Forecast[Metric], "Gross profit" ) VAR v = CALCULATE ( SUM ( Forecast[P10] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ) VAR lastA = CALCULATE ( MAX ( Forecast[Month] ), REMOVEFILTERS ( Forecast[Month] ), NOT ISBLANK ( Forecast[Actual] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ) RETURN DIVIDE ( IF ( ISBLANK ( v ) && MAX ( Forecast[Month] ) = lastA, CALCULATE ( SUM ( Forecast[Actual] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ), v ), IF ( mt IN { "Gross profit", "Net sales" }, 100000, 1 ) )
		formatString: #,##0.0
		displayFolder: 5 Forecast
		lineageTag: 3de6d224-a591-4f9d-b098-1d4eda59ea69

	/// Forecast high case (P90), in chart units.
	measure 'Fcst P90' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) VAR mt = SELECTEDVALUE ( Forecast[Metric], "Gross profit" ) VAR v = CALCULATE ( SUM ( Forecast[P90] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ) VAR lastA = CALCULATE ( MAX ( Forecast[Month] ), REMOVEFILTERS ( Forecast[Month] ), NOT ISBLANK ( Forecast[Actual] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ) RETURN DIVIDE ( IF ( ISBLANK ( v ) && MAX ( Forecast[Month] ) = lastA, CALCULATE ( SUM ( Forecast[Actual] ), TREATAS ( { sc }, Scenario[Scenario] ), TREATAS ( { mt }, Forecast[Metric] ) ), v ), IF ( mt IN { "Gross profit", "Net sales" }, 100000, 1 ) )
		formatString: #,##0.0
		displayFolder: 5 Forecast
		lineageTag: ccc89b89-4658-42e4-9166-546afa11f17d

	/// 2026 gross profit, simulation median.
	measure 'F26 Gross Profit' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) RETURN CALCULATE ( SUM ( 'Forecast 2026'[P50] ), 'Forecast 2026'[Metric] = "Gross profit", TREATAS ( { sc }, Scenario[Scenario] ) )
		formatString: ₹#,##0
		displayFolder: 5 Forecast
		lineageTag: c1aa1b73-b401-483c-a1a3-5082413ce1eb

	/// 2026 revenue orders, median.
	measure 'F26 Revenue Orders' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) RETURN CALCULATE ( SUM ( 'Forecast 2026'[P50] ), 'Forecast 2026'[Metric] = "Revenue orders", TREATAS ( { sc }, Scenario[Scenario] ) )
		formatString: #,##0
		displayFolder: 5 Forecast
		lineageTag: 1a479238-8c6f-4798-a6aa-056607a0dfb7

	/// 2026 first-time buyers, median.
	measure 'F26 New Buyers' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) RETURN CALCULATE ( SUM ( 'Forecast 2026'[P50] ), 'Forecast 2026'[Metric] = "New buyers", TREATAS ( { sc }, Scenario[Scenario] ) )
		formatString: #,##0
		displayFolder: 5 Forecast
		lineageTag: 4dd50c1d-d362-4f3a-8a7a-a660eea4f48e

	/// 2026 profit per active customer, median.
	measure 'F26 PPAC' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) RETURN CALCULATE ( SUM ( 'Forecast 2026'[P50] ), 'Forecast 2026'[Metric] = "PPAC", TREATAS ( { sc }, Scenario[Scenario] ) )
		formatString: ₹#,##0
		displayFolder: 5 Forecast
		lineageTag: 54fb9bfd-6b3a-44aa-800c-fc6f1af04a9f

	/// 2026 PPAC target (2025 run-rate + 5%).
	measure 'F26 PPAC Target' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) RETURN CALCULATE ( SUM ( 'Forecast 2026'[P50] ), 'Forecast 2026'[Metric] = "PPAC target", TREATAS ( { sc }, Scenario[Scenario] ) )
		formatString: ₹#,##0
		displayFolder: 5 Forecast
		lineageTag: d7950efb-4145-4098-8655-096a5de842dc

	/// Share of simulated runs in which 2026 PPAC reaches its target.
	measure 'F26 P(PPAC hits target)' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) RETURN CALCULATE ( SUM ( 'Forecast 2026'[P50] ), 'Forecast 2026'[Metric] = "P(PPAC hits target)", TREATAS ( { sc }, Scenario[Scenario] ) )
		formatString: 0%
		displayFolder: 5 Forecast
		lineageTag: 3d416d4c-b910-4201-a87c-bd3d4bf4c227

	/// Mid estimate of extra 2026 gross profit.
	measure 'Lever Uplift' = SUM ( Levers[Uplift Mid] )
		formatString: ₹#,##0
		displayFolder: 5 Forecast
		lineageTag: 65315df8-755f-479b-8a59-30cc8033ab3f

	/// Low estimate of extra 2026 gross profit.
	measure 'Lever Uplift Low' = SUM ( Levers[Uplift Low] )
		formatString: ₹#,##0
		displayFolder: 5 Forecast
		lineageTag: d7896f6b-2632-4787-9af4-7bee5d4bcdab

	/// High estimate of extra 2026 gross profit.
	measure 'Lever Uplift High' = SUM ( Levers[Uplift High] )
		formatString: ₹#,##0
		displayFolder: 5 Forecast
		lineageTag: 18f8246c-52b6-4299-82f6-78668c06b8d3

	/// Orders placed, any status.
	measure 'Total Orders' = DISTINCTCOUNTNOBLANK ( Order_Items[Order ID] )
		formatString: #,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 5c589e5d-89a4-4aed-9931-9c3403cda1e2

	/// Net Sales for the same period last year.
	measure 'Net Sales PY' = CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: 4f9958fd-dff0-412e-9f92-8b3007844db1

	/// Discount rate for the same period last year.
	measure 'Discount Rate % PY' = CALCULATE ( [Discount Rate %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.0%
		displayFolder: 1 Sales & Profit
		lineageTag: 46240881-11fe-4f76-b342-16eaca05e46a

	/// Gross profit in 2024, the last full year (benchmark for the 2026 forecast).
	measure 'Gross Profit 2024' = CALCULATE ( [Gross Profit], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 )
		formatString: ₹#,##0
		displayFolder: 1 Sales & Profit
		lineageTag: c8739cf4-f8d1-4d68-a4a5-d89089bd8bcc

	/// Subcategory with the highest Gross Profit in the current selection.
	measure 'Top Subcategory' = CONCATENATEX ( TOPN ( 1, FILTER ( VALUES ( Products[Subcategory] ), NOT ISBLANK ( [Gross Profit] ) ), [Gross Profit], DESC ), Products[Subcategory], ", " )
		displayFolder: 2 Category
		lineageTag: a1249ad7-7b75-4b9f-9ea6-819d6f743cd4

	/// Category in the current filter context (drill-through title).
	measure 'Selected Category' = SELECTEDVALUE ( Products[Category], "All categories" )
		displayFolder: 2 Category
		lineageTag: 5c8f373e-2178-424c-8cda-d82b9376097b

	/// Customers who have placed at least one order.
	measure 'Purchasing Customers' = CALCULATE ( COUNTROWS ( Customers ), Customers[Customer Type] <> "No Purchase" )
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: 6b0aa5e7-4db3-4494-9ed8-d04a29bd9404

	/// Customers with exactly one lifetime order.
	measure 'One-Time Customers' = CALCULATE ( COUNTROWS ( Customers ), Customers[Customer Type] = "One-Time" )
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: be077296-646b-4f0d-bf45-39cb1746011a

	/// Customers with two or more lifetime orders.
	measure 'Recurring Customers' = CALCULATE ( COUNTROWS ( Customers ), Customers[Customer Type] = "Recurring" )
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: 3649acf6-7e54-4632-8fca-f586578961e4

	/// Repeat rate: recurring customers / buying customers.
	measure 'Recurring Customer %' = DIVIDE ( [Recurring Customers], [Purchasing Customers] )
		formatString: 0.0%
		displayFolder: 3 Customers
		lineageTag: 9b467f38-a7dc-4938-ba52-4c39fb991528

	/// One-time customers / buying customers.
	measure 'One-Time Customer %' = DIVIDE ( [One-Time Customers], [Purchasing Customers] )
		formatString: 0.0%
		displayFolder: 3 Customers
		lineageTag: 6553a3f4-6fa1-4957-b213-34baf1054212

	/// Share of buying customers with three or more lifetime orders.
	measure 'Buyers With 3+ Orders %' = DIVIDE ( CALCULATE ( [Purchasing Customers], Customers[Lifetime Orders] >= 3 ), [Purchasing Customers] )
		formatString: 0.0%
		displayFolder: 3 Customers
		lineageTag: 5d7b381c-d2f3-4c51-87a6-735e4cd70351

	/// Customers whose first order falls in the period.
	measure 'New Buyers' = CALCULATE ( COUNTROWS ( Customers ), TREATAS ( VALUES ( 'Date'[Date] ), Customers[First Order Date] ) )
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: 4bbdb964-23f0-42dd-af87-66d0866290f4

	/// New buyers in 2024, the last full year.
	measure 'New Buyers 2024' = CALCULATE ( [New Buyers], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 )
		formatString: #,##0
		displayFolder: 3 Customers
		lineageTag: 63487b4a-c137-48e9-ba09-7e028a5b9a4c

	/// Most recent registration date in the selection.
	measure 'Last Sign-up Date' = MAX ( Customers[Join Date] )
		formatString: dd mmm yyyy
		displayFolder: 3 Customers
		lineageTag: e1198cb6-b4a6-457f-aea0-b388ea4bd03c

	/// 2026 gross profit, low case (P10).
	measure 'F26 Gross Profit Low' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) RETURN CALCULATE ( SUM ( 'Forecast 2026'[P10] ), 'Forecast 2026'[Metric] = "Gross profit", TREATAS ( { sc }, Scenario[Scenario] ) )
		formatString: ₹#,##0
		displayFolder: 5 Forecast
		lineageTag: 74cb33d1-9d6a-4970-8741-70750781cb7a

	/// 2026 gross profit, high case (P90).
	measure 'F26 Gross Profit High' = VAR sc = SELECTEDVALUE ( Scenario[Scenario], "A · No new sign-ups" ) RETURN CALCULATE ( SUM ( 'Forecast 2026'[P90] ), 'Forecast 2026'[Metric] = "Gross profit", TREATAS ( { sc }, Scenario[Scenario] ) )
		formatString: ₹#,##0
		displayFolder: 5 Forecast
		lineageTag: 6772a385-e75c-4dee-b8c0-9290ca9bae9c

	/// Mid lever uplift in lakh, for the lever chart.
	measure 'Lever Uplift ₹ L' = DIVIDE ( [Lever Uplift], 100000 )
		formatString: ₹#,##0.0 \L
		displayFolder: 5 Forecast
		lineageTag: 84d12f03-1101-46d9-be01-5747b1fb740e

	/// Low lever uplift in lakh (tooltip).
	measure 'Lever Uplift Low ₹ L' = DIVIDE ( [Lever Uplift Low], 100000 )
		formatString: ₹#,##0.0 \L
		displayFolder: 5 Forecast
		lineageTag: 8fd7dfa4-58f2-4d86-b404-fe305e4764d6

	/// High lever uplift in lakh (tooltip).
	measure 'Lever Uplift High ₹ L' = DIVIDE ( [Lever Uplift High], 100000 )
		formatString: ₹#,##0.0 \L
		displayFolder: 5 Forecast
		lineageTag: 4eac29a3-465c-4ae2-be3e-6fdec0af1c80

	/// Gross profit in lakh (₹1 L = ₹1,00,000), for charts and tables.
	measure 'Gross Profit ₹ L' = DIVIDE ( [Gross Profit], 100000 )
		formatString: ₹#,##0.0 \L
		displayFolder: 6 Display
		lineageTag: d3f4399a-f334-4ffe-a55f-d6cb420134e2

	/// Net sales in lakh, for tables.
	measure 'Net Sales ₹ L' = DIVIDE ( [Net Sales], 100000 )
		formatString: ₹#,##0.0 \L
		displayFolder: 6 Display
		lineageTag: 51b0c5bc-33ba-440c-9f1b-5f960d566b10

	/// COGS in lakh, for tables.
	measure 'COGS ₹ L' = DIVIDE ( [COGS], 100000 )
		formatString: ₹#,##0.0 \L
		displayFolder: 6 Display
		lineageTag: 57b3ab5a-b6da-4b98-94e2-5ff4422183d5

	/// Gross profit per active customer, in lakh.
	measure 'Profit per Customer ₹ L' = DIVIDE ( [Profit per Active Customer], 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 6 Display
		lineageTag: a773c788-34a5-4570-be0d-fdde61a060c6

	/// Gross profit for cards, in Indian units (₹ L / ₹ Cr).
	measure 'Card Gross Profit' = ( VAR _v = [Gross Profit] RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), ABS ( _v ) >= 10000000, FORMAT ( DIVIDE ( _v, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _v ) >= 1000000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _v ) >= 100000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _v, "₹#,##0", "en-US" ) ) )
		displayFolder: 6 Display
		lineageTag: 5862cb69-348f-42b3-b412-333a30004a11

	/// Net sales for cards, in Indian units.
	measure 'Card Net Sales' = ( VAR _v = [Net Sales] RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), ABS ( _v ) >= 10000000, FORMAT ( DIVIDE ( _v, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _v ) >= 1000000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _v ) >= 100000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _v, "₹#,##0", "en-US" ) ) )
		displayFolder: 6 Display
		lineageTag: 072eca02-27b2-4e3b-a4b7-c84c5277d809

	/// Gross margin for cards.
	measure 'Card Gross Margin' = FORMAT ( [Gross Margin %], "0.0%" )
		displayFolder: 6 Display
		lineageTag: b4741c16-0dda-4f3d-8179-32b5ea9724f1

	/// Discount rate for cards.
	measure 'Card Discount Rate' = FORMAT ( [Discount Rate %], "0.0%" )
		displayFolder: 6 Display
		lineageTag: 7f4fcaa1-494d-4c00-9cfd-d0351aec45bf

	/// PPAC for cards.
	measure 'Card PPAC' = ( VAR _v = [Profit per Active Customer] RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), ABS ( _v ) >= 10000000, FORMAT ( DIVIDE ( _v, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _v ) >= 1000000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _v ) >= 100000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _v, "₹#,##0", "en-US" ) ) )
		displayFolder: 6 Display
