	/// Profit per recurring customer, in Indian units.
	measure 'Card Profit per Recurring' = ( VAR _v = [Profit per Recurring Customer] RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), ABS ( _v ) >= 10000000, FORMAT ( DIVIDE ( _v, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _v ) >= 1000000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _v ) >= 100000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _v, "₹#,##0", "en-US" ) ) )
		displayFolder: 6 Display
		lineageTag: 0d5e1178-ed20-4f49-843b-606c71b57c07

	/// Profit per one-time customer, in Indian units.
	measure 'Card Profit per One-Time' = ( VAR _v = [Profit per One-Time Customer] RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), ABS ( _v ) >= 10000000, FORMAT ( DIVIDE ( _v, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _v ) >= 1000000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _v ) >= 100000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _v, "₹#,##0", "en-US" ) ) )
		displayFolder: 6 Display
		lineageTag: 7e3ad6d6-57c3-4f07-a270-386ca272a0e0

	/// Gross profit from recurring customers, in Indian units.
	measure 'Card Recurring Profit' = ( VAR _v = [Recurring Customer Profit] RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), ABS ( _v ) >= 10000000, FORMAT ( DIVIDE ( _v, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _v ) >= 1000000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _v ) >= 100000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _v, "₹#,##0", "en-US" ) ) )
		displayFolder: 6 Display
		lineageTag: 17eef458-1076-47e6-bf1c-d39d20f8d597

	/// Share of all gross profit, for cards.
	measure 'Card Category Share' = FORMAT ( [Category Profit Share %], "0%" )
		displayFolder: 6 Display
		lineageTag: 40490779-69bd-4edb-9c0a-dbe636ec82ce

	/// Lines sold below cost, for cards.
	measure 'Card Loss Lines' = IF ( ISBLANK ( [Loss-Making Lines] ), "0", FORMAT ( [Loss-Making Lines], "#,##0" ) )
		displayFolder: 6 Display
		lineageTag: a9a8e6c3-da2e-404c-afc3-9435d4123853

	/// 2026 gross profit forecast in lakh, for cards (same unit as its range).
	measure 'Card F26 Gross Profit' = FORMAT ( DIVIDE ( [F26 Gross Profit], 100000 ), "₹#,##0.0", "en-US" ) & " L"
		displayFolder: 6 Display
		lineageTag: fbaa45f9-4ba1-443b-8796-0dbbb160fd97

	/// 80% range of 2026 gross profit, in lakh.
	measure 'Card F26 Range' = "₹" & FORMAT ( DIVIDE ( [F26 Gross Profit Low], 100000 ), "0" ) & "–" & FORMAT ( DIVIDE ( [F26 Gross Profit High], 100000 ), "0" ) & " L"
		displayFolder: 6 Display
		lineageTag: 7a683549-ad1a-48f3-975a-afbcac5ba788

	/// 2026 revenue orders forecast, for cards.
	measure 'Card F26 Orders' = FORMAT ( [F26 Revenue Orders], "#,##0" )
		displayFolder: 6 Display
		lineageTag: 56d12a1b-fdcb-4273-898f-045e3af2af72

	/// 2026 new buyers forecast, for cards.
	measure 'Card F26 New Buyers' = FORMAT ( [F26 New Buyers], "#,##0" )
		displayFolder: 6 Display
		lineageTag: 2dd32980-0c8a-48df-93ab-35d69d7b0d6d

	/// 2026 PPAC forecast, for cards.
	measure 'Card F26 PPAC' = ( VAR _v = [F26 PPAC] RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), ABS ( _v ) >= 10000000, FORMAT ( DIVIDE ( _v, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _v ) >= 1000000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _v ) >= 100000, FORMAT ( DIVIDE ( _v, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _v, "₹#,##0", "en-US" ) ) )
		displayFolder: 6 Display
		lineageTag: 18523415-b43e-4ed2-9793-60f2a8b9bdaa

	/// Chance that 2026 PPAC reaches its target, for cards.
	measure 'Card F26 Hit Chance' = FORMAT ( [F26 P(PPAC hits target)], "0%" )
		displayFolder: 6 Display
		lineageTag: 1e698ff7-b109-40cf-ad5d-f34acc81c846

	/// Card line: buyers out of registered customers.
	measure 'Δ Buyers' = "of " & FORMAT ( [Registered Customers], "#,##0" ) & " registered (" & FORMAT ( [Customer Activation Rate %], "0%" ) & ")"
		displayFolder: 6 Display
		lineageTag: ada86a8b-28f2-474e-be12-5b2a2fbcd873

	/// Card line: recurring and one-time customer counts.
	measure 'Δ Repeat Rate' = FORMAT ( [Recurring Customers], "#,##0" ) & " vs " & FORMAT ( [One-Time Customers], "#,##0" ) & " one-time"
		displayFolder: 6 Display
		lineageTag: 855a77ed-76b6-4fcf-90e8-f700b9a50a35

	/// Card line: recurring profit out of the total.
	measure 'Δ Recurring Profit Share' = [Card Recurring Profit] & " of " & [Card Gross Profit]
		displayFolder: 6 Display
		lineageTag: 578e8863-d0cd-4b2a-b002-5e9cd982ad3d

	/// Card line: profit per customer by type.
	measure 'Δ Value Multiplier' = FORMAT ( DIVIDE ( [Profit per Recurring Customer], 100000 ), "₹#,##0.00", "en-US" ) & " L" & " vs " & FORMAT ( DIVIDE ( [Profit per One-Time Customer], 100000 ), "₹#,##0.00", "en-US" ) & " L"
		displayFolder: 6 Display
		lineageTag: 4469e827-9ad1-40ac-97d5-6eee51415406

	/// Card line: share of buyers with 3+ orders.
	measure 'Δ Avg Orders' = FORMAT ( [Buyers With 3+ Orders %], "0%" ) & " ordered 3+ times"
		displayFolder: 6 Display
		lineageTag: a63d06c2-935c-4230-8e11-90b94a54b3e2

	/// Card line: never-ordered customers as a share of registered.
	measure 'Δ Never Ordered' = FORMAT ( DIVIDE ( [Never-Purchased Customers], [Registered Customers] ), "0%" ) & " of registered"
		displayFolder: 6 Display
		lineageTag: e10285dc-ea1d-4763-8459-ef60e114a491

	/// Card change line for Gross Profit: arrow and change vs last year.
	measure 'Δ Gross Profit' = VAR p = [Gross Profit PY] VAR d = DIVIDE ( [Gross Profit] - [Gross Profit PY], [Gross Profit PY] ) RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ), "Jan 2023 – Oct 2025", IF ( ISBLANK ( p ), "No prior year", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & " vs last year" ) )
		displayFolder: 6 Display
		lineageTag: e647c9ec-8831-43c9-a048-20e23be1766c

	/// Colour of the Gross Profit change line: green up, red down, grey when not comparable.
	measure 'Δ Gross Profit Color' = VAR p = [Gross Profit PY] RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ) || ISBLANK ( p ), "#5B6B7F", IF ( [Gross Profit] >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 6 Display
		lineageTag: 9f338261-d3f6-4e97-951c-03c9ec2f0f97

	/// Card change line for Net Sales: arrow and change vs last year.
	measure 'Δ Net Sales' = VAR p = [Net Sales PY] VAR d = DIVIDE ( [Net Sales] - [Net Sales PY], [Net Sales PY] ) RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ), "Jan 2023 – Oct 2025", IF ( ISBLANK ( p ), "No prior year", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & " vs last year" ) )
		displayFolder: 6 Display
		lineageTag: de51b8cc-2327-4bfa-91bf-788505d7ecd8

	/// Colour of the Net Sales change line: green up, red down, grey when not comparable.
	measure 'Δ Net Sales Color' = VAR p = [Net Sales PY] RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ) || ISBLANK ( p ), "#5B6B7F", IF ( [Net Sales] >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 6 Display
		lineageTag: 06cef8de-3e44-4470-951f-6fd8012f6894

	/// Card change line for Gross Margin: arrow and change vs last year.
	measure 'Δ Gross Margin' = VAR p = [Gross Margin % PY] VAR d = ( [Gross Margin %] - [Gross Margin % PY] ) * 100 RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ), "Jan 2023 – Oct 2025", IF ( ISBLANK ( p ), "No prior year", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0" ) & " pp" & " vs last year" ) )
		displayFolder: 6 Display
		lineageTag: 50813e6f-9842-4e19-9764-0498ceba433b

	/// Colour of the Gross Margin change line: green up, red down, grey when not comparable.
	measure 'Δ Gross Margin Color' = VAR p = [Gross Margin % PY] RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ) || ISBLANK ( p ), "#5B6B7F", IF ( [Gross Margin %] >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 6 Display
		lineageTag: 44ba556d-76a4-4aa4-972c-b3fbfdec9b0e

	/// Card change line for Discount Rate: arrow and change vs last year.
	measure 'Δ Discount Rate' = VAR p = [Discount Rate % PY] VAR d = ( [Discount Rate %] - [Discount Rate % PY] ) * 100 RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ), "Jan 2023 – Oct 2025", IF ( ISBLANK ( p ), "No prior year", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0" ) & " pp" & " vs last year" ) )
		displayFolder: 6 Display
		lineageTag: 99f4d221-58be-4d45-9eaf-3dc25ea068e2

	/// Colour of the Discount Rate change line: red up, green down, grey when not comparable.
	measure 'Δ Discount Rate Color' = VAR p = [Discount Rate % PY] RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ) || ISBLANK ( p ), "#5B6B7F", IF ( [Discount Rate %] >= p, "#C0392B", "#1E7F4B" ) )
		displayFolder: 6 Display
		lineageTag: f953b643-7ed0-4342-bbd5-a19da0269ad8

	/// Card change line for PPAC: arrow and change vs last year.
	measure 'Δ PPAC' = VAR p = [Profit per Active Customer PY] VAR d = DIVIDE ( [Profit per Active Customer] - [Profit per Active Customer PY], [Profit per Active Customer PY] ) RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ), "Jan 2023 – Oct 2025", IF ( ISBLANK ( p ), "No prior year", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & " vs last year" ) )
		displayFolder: 6 Display
		lineageTag: 7279bf25-6271-4c2e-81a0-bd9909afcf3c

	/// Colour of the PPAC change line: green up, red down, grey when not comparable.
	measure 'Δ PPAC Color' = VAR p = [Profit per Active Customer PY] RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ) || ISBLANK ( p ), "#5B6B7F", IF ( [Profit per Active Customer] >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 6 Display
		lineageTag: 1b413e32-186b-4734-bbf5-294f1447fec4

	/// Card change line for Orders per Customer: arrow and change vs last year.
	measure 'Δ Orders per Customer' = VAR p = [Orders per Active Customer PY] VAR d = DIVIDE ( [Orders per Active Customer] - [Orders per Active Customer PY], [Orders per Active Customer PY] ) RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ), "Jan 2023 – Oct 2025", IF ( ISBLANK ( p ), "No prior year", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & " vs last year" ) )
		displayFolder: 6 Display
		lineageTag: ce1a5fae-6392-4e75-a01c-d12f6a629840

	/// Colour of the Orders per Customer change line: green up, red down, grey when not comparable.
	measure 'Δ Orders per Customer Color' = VAR p = [Orders per Active Customer PY] RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ) || ISBLANK ( p ), "#5B6B7F", IF ( [Orders per Active Customer] >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 6 Display
		lineageTag: 48a2e50f-a43c-4491-b6a6-0a41d92c7abc

	/// Card change line for AOV: arrow and change vs last year.
	measure 'Δ AOV' = VAR p = [Avg Order Value PY] VAR d = DIVIDE ( [Avg Order Value] - [Avg Order Value PY], [Avg Order Value PY] ) RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ), "Jan 2023 – Oct 2025", IF ( ISBLANK ( p ), "No prior year", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & " vs last year" ) )
		displayFolder: 6 Display
		lineageTag: ebc40685-2b84-4689-be15-0836744ec8da

	/// Colour of the AOV change line: green up, red down, grey when not comparable.
	measure 'Δ AOV Color' = VAR p = [Avg Order Value PY] RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ) || ISBLANK ( p ), "#5B6B7F", IF ( [Avg Order Value] >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 6 Display
		lineageTag: 7228941a-5877-4470-b814-33a9a2d4add4

	/// Card change line for Active Customers: arrow and change vs last year.
	measure 'Δ Active Customers' = VAR p = [Active Customers PY] VAR d = DIVIDE ( [Active Customers] - [Active Customers PY], [Active Customers PY] ) RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ), "Jan 2023 – Oct 2025", IF ( ISBLANK ( p ), "No prior year", IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & " vs last year" ) )
		displayFolder: 6 Display
		lineageTag: de7963f4-4a28-44f6-b1c6-6ca24399ab32

	/// Colour of the Active Customers change line: green up, red down, grey when not comparable.
	measure 'Δ Active Customers Color' = VAR p = [Active Customers PY] RETURN IF ( NOT HASONEVALUE ( 'Date'[Year] ) || ISBLANK ( p ), "#5B6B7F", IF ( [Active Customers] >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 6 Display
		lineageTag: 998b3bea-f951-401a-a549-c2433bbaf4d5

	/// Card line: gross profit and share of the top category.
	measure 'Δ Top Category' = VAR c = [Top Profit Category] VAR gp = CALCULATE ( [Gross Profit], Products[Category] = c ) RETURN ( VAR _g = gp RETURN SWITCH ( TRUE (), ISBLANK ( _g ), BLANK (), ABS ( _g ) >= 10000000, FORMAT ( DIVIDE ( _g, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _g ) >= 1000000, FORMAT ( DIVIDE ( _g, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _g ) >= 100000, FORMAT ( DIVIDE ( _g, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _g, "₹#,##0", "en-US" ) ) ) & " · " & FORMAT ( DIVIDE ( gp, [Gross Profit] ), "0%" ) & " of profit"
		displayFolder: 6 Display
		lineageTag: d3acebbf-9756-40ba-a720-a9f119c707b1

	/// Card line: gross profit and share of the lowest category.
	measure 'Δ Lowest Category' = VAR c = [Lowest Profit Category] VAR gp = CALCULATE ( [Gross Profit], Products[Category] = c ) RETURN ( VAR _g = gp RETURN SWITCH ( TRUE (), ISBLANK ( _g ), BLANK (), ABS ( _g ) >= 10000000, FORMAT ( DIVIDE ( _g, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _g ) >= 1000000, FORMAT ( DIVIDE ( _g, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _g ) >= 100000, FORMAT ( DIVIDE ( _g, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _g, "₹#,##0", "en-US" ) ) ) & " · " & FORMAT ( DIVIDE ( gp, [Gross Profit] ), "0%" ) & " of profit"
		displayFolder: 6 Display
		lineageTag: 1d11076a-d312-438f-8633-c9849f7c8a96

	/// Card line: PPAC distance from target (coloured by KPI Status Color).
	measure 'Δ PPAC Target' = VAR v = [Profit per Active Customer] VAR t = [Profit per Active Customer Target] RETURN IF ( ISBLANK ( t ), "No target (first year)", FORMAT ( ABS ( DIVIDE ( v - t, t ) ), "0.0%" ) & IF ( v >= t, " ahead of target", " behind target" ) )
		displayFolder: 6 Display
		lineageTag: e81a2d5b-d6ad-44bf-b613-3f818a11d922

	/// Card line: margin gap to all products.
	measure 'Δ Category Margin' = FORMAT ( [Margin vs Avg (pp)], "+0.0;-0.0;0.0" ) & " pp vs all products"
		displayFolder: 6 Display
		lineageTag: 29d3c2e2-ba38-402c-9004-bffe0581771f

	/// Card line: total gross profit.
	measure 'Δ Category Share' = "of " & ( VAR _t = CALCULATE ( [Gross Profit], REMOVEFILTERS ( Products ) ) RETURN SWITCH ( TRUE (), ISBLANK ( _t ), BLANK (), ABS ( _t ) >= 10000000, FORMAT ( DIVIDE ( _t, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _t ) >= 1000000, FORMAT ( DIVIDE ( _t, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _t ) >= 100000, FORMAT ( DIVIDE ( _t, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _t, "₹#,##0", "en-US" ) ) ) & " total"
		displayFolder: 6 Display
		lineageTag: 48c8e449-9908-4a9f-b501-94bd313c5c48

	/// Card line: profit lost on lines sold below cost.
	measure 'Δ Loss Lines' = ( VAR _l = -[Profit Lost on Loss-Making Lines] RETURN SWITCH ( TRUE (), ISBLANK ( _l ), BLANK (), ABS ( _l ) >= 10000000, FORMAT ( DIVIDE ( _l, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _l ) >= 1000000, FORMAT ( DIVIDE ( _l, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _l ) >= 100000, FORMAT ( DIVIDE ( _l, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _l, "₹#,##0", "en-US" ) ) ) & " lost below cost"
		displayFolder: 6 Display
		lineageTag: de3dcdb0-f8e5-4dcd-8f08-c02d64edcc44

	/// Card line: 2026 forecast vs 2024 actual gross profit.
	measure 'Δ F26 Gross Profit' = VAR b = [Gross Profit 2024] VAR d = DIVIDE ( [F26 Gross Profit] - b, b ) RETURN IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0%" ) & " vs 2024 (" & ( VAR _b = b RETURN SWITCH ( TRUE (), ISBLANK ( _b ), BLANK (), ABS ( _b ) >= 10000000, FORMAT ( DIVIDE ( _b, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _b ) >= 1000000, FORMAT ( DIVIDE ( _b, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _b ) >= 100000, FORMAT ( DIVIDE ( _b, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _b, "₹#,##0", "en-US" ) ) ) & ")"
		displayFolder: 6 Display
		lineageTag: 5a60c09a-e0df-469c-bcf3-7088c61fa631

	/// Colour of the 2026 profit line.
	measure 'Δ F26 Gross Profit Color' = IF ( [F26 Gross Profit] >= [Gross Profit 2024], "#1E7F4B", "#C0392B" )
		displayFolder: 6 Display
		lineageTag: 23797e75-d45b-4a71-84c9-334e9fac1a98

	/// Card line for the forecast range.
	measure 'Δ F26 Range' = "80% of 2,000 runs"
		displayFolder: 6 Display
		lineageTag: acc2b7db-f30f-4f13-b011-9e9270c68d05

	/// Card line: 2026 orders vs 2024.
	measure 'Δ F26 Orders' = VAR b = CALCULATE ( [Revenue Orders], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ) VAR d = DIVIDE ( [F26 Revenue Orders] - b, b ) RETURN IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0%" ) & " vs 2024 (" & b & ")"
		displayFolder: 6 Display
		lineageTag: 9d0342d2-8afc-491e-a524-a9fdb23b7d0c

	/// Colour of the 2026 orders line.
	measure 'Δ F26 Orders Color' = IF ( [F26 Revenue Orders] >= CALCULATE ( [Revenue Orders], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ), "#1E7F4B", "#C0392B" )
		displayFolder: 6 Display
		lineageTag: 792c1542-b414-43dd-aa05-b48d1a469f74

	/// Card line: 2026 new buyers vs 2024.
	measure 'Δ F26 New Buyers' = VAR b = [New Buyers 2024] VAR d = DIVIDE ( [F26 New Buyers] - b, b ) RETURN IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0%" ) & " vs 2024 (" & b & ")"
		displayFolder: 6 Display
		lineageTag: 07663e7c-4674-42db-893a-0dc7a4da67e3

	/// Colour of the 2026 new-buyer line.
	measure 'Δ F26 New Buyers Color' = IF ( [F26 New Buyers] >= [New Buyers 2024], "#1E7F4B", "#C0392B" )
		displayFolder: 6 Display
		lineageTag: f3042667-a2e3-49a2-a814-e9d4408a46b4

	/// Card line: 2026 PPAC vs its target.
	measure 'Δ F26 PPAC' = VAR t = [F26 PPAC Target] VAR d = DIVIDE ( [F26 PPAC] - t, t ) RETURN FORMAT ( ABS ( d ), "0%" ) & IF ( d >= 0, " above ", " below " ) & ( VAR _t = t RETURN SWITCH ( TRUE (), ISBLANK ( _t ), BLANK (), ABS ( _t ) >= 10000000, FORMAT ( DIVIDE ( _t, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _t ) >= 1000000, FORMAT ( DIVIDE ( _t, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _t ) >= 100000, FORMAT ( DIVIDE ( _t, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _t, "₹#,##0", "en-US" ) ) ) & " target"
		displayFolder: 6 Display
		lineageTag: 8655feea-697e-402a-b5cb-8fd308d2b202

	/// Colour of the 2026 PPAC line.
	measure 'Δ F26 PPAC Color' = IF ( [F26 PPAC] >= [F26 PPAC Target], "#1E7F4B", "#C0392B" )
		displayFolder: 6 Display
		lineageTag: b38d2fad-af70-41a2-8fa3-b3bb69cd4806

	/// Card line for the target probability.
	measure 'Δ F26 Hit Chance' = "of runs reach target"
		displayFolder: 6 Display
		lineageTag: 57d8e9da-d6c6-4967-a492-43fa94be5db6

	/// Grey for card lines that carry context, not a change.
	measure 'Δ Neutral Color' = "#5B6B7F"
		displayFolder: 6 Display
		lineageTag: 89557b58-efe9-437c-8b0b-380de00b4b2f

	/// Amber for card lines that flag an opportunity or risk.
	measure 'Δ Warn Color' = "#A15F00"
		displayFolder: 6 Display
		lineageTag: a302e7c0-0703-4994-9aa1-dbab65ec6778

	/// Footer: source, refresh date and the main caveats.
	measure 'Footer Text' = "Source: Online Sales Data, Jan 2023 – Oct 2025  ·  Refreshed " & FORMAT ( MAX ( 'Refresh Info'[Refreshed] ), "d mmm yyyy" ) & "  ·  Profit excl. shipping and marketing  ·  Synthetic-looking data"
		displayFolder: 6 Display
		lineageTag: fe3eacce-54e6-4a7c-b959-ecae554e7112

	/// Page 1 headline: repeat rate and recurring customers' share of gross profit.
	measure 'Title Retention' = FORMAT ( [Recurring Customer %], "0%" ) & " of buyers came back, and they earn " & FORMAT ( [Recurring Profit Share %], "0%" ) & " of gross profit"
		displayFolder: 7 Titles
		lineageTag: 713de23d-a487-4a0a-b779-5b97ccaec71c

	/// New-buyer chart title: last registration date and first-time buyers per year.
	measure 'Title New Buyers' = VAR seq = CONCATENATEX ( FILTER ( VALUES ( 'Date'[Year] ), NOT ISBLANK ( [New Buyers] ) ), [New Buyers], "→", 'Date'[Year], ASC ) RETURN "Sign-ups stopped " & FORMAT ( [Last Sign-up Date], "d mmm yyyy" ) & "; new buyers " & seq
		displayFolder: 7 Titles
		lineageTag: b3adbcca-b8a3-43ca-8580-04aa0b14fba8

	/// Order-frequency chart title.
	measure 'Title Order Frequency' = FORMAT ( [One-Time Customer %], "0%" ) & " of buyers ordered once; " & FORMAT ( [Buyers With 3+ Orders %], "0%" ) & " ordered 3+ times"
		displayFolder: 7 Titles
		lineageTag: 72c12f2f-36ef-4f8b-aac3-bbb1d7e8ac83

	/// Profit-per-customer chart title.
	measure 'Title Value per Customer' = "Recurring buyers earn " & FORMAT ( [Recurring Value Multiplier], "0.0" ) & "x (" & FORMAT ( DIVIDE ( [Profit per Recurring Customer], 100000 ), "₹#,##0.00", "en-US" ) & " L" & " vs " & FORMAT ( DIVIDE ( [Profit per One-Time Customer], 100000 ), "₹#,##0.00", "en-US" ) & " L" & " each)"
		displayFolder: 7 Titles
		lineageTag: cfb86069-5efc-4dc9-b7c2-20c739c25b54

	/// Profit-by-type chart title: recurring share of gross profit in the first and last year.
	measure 'Title Profit by Type' = VAR ys = FILTER ( VALUES ( 'Date'[Year] ), NOT ISBLANK ( [Gross Profit] ) ) VAR y0 = MINX ( ys, 'Date'[Year] ) VAR y1 = MAXX ( ys, 'Date'[Year] ) RETURN "Repeat customers: " & FORMAT ( CALCULATE ( [Recurring Profit Share %], 'Date'[Year] = y0 ), "0%" ) & " of profit in " & y0 & ", " & FORMAT ( CALCULATE ( [Recurring Profit Share %], 'Date'[Year] = y1 ), "0%" ) & " in " & y1
		displayFolder: 7 Titles
		lineageTag: 15396491-0974-4211-8be4-15ea3f375ad7

	/// Segment chart title: highest and lowest repeat rate by segment.
	measure 'Title Segment' = VAR t = ADDCOLUMNS ( FILTER ( VALUES ( Customers[Segment] ), NOT ISBLANK ( [Purchasing Customers] ) ), "@r", [Recurring Customer %] ) VAR hi = MAXX ( TOPN ( 1, t, [@r], DESC ), Customers[Segment] ) VAR lo = MAXX ( TOPN ( 1, t, [@r], ASC ), Customers[Segment] ) RETURN IF ( COUNTROWS ( t ) = 1, "Repeat rate in " & hi & ": " & FORMAT ( MAXX ( t, [@r] ), "0%" ), "Repeat rate: " & FORMAT ( MAXX ( t, [@r] ), "0%" ) & " in " & hi & " vs " & FORMAT ( MINX ( t, [@r] ), "0%" ) & " in " & lo )
		displayFolder: 7 Titles
		lineageTag: 13b8875f-d318-46e8-a799-e6819ada986b

	/// Page 2 headline: top category, its profit and share, and the margin range.
	measure 'Title Category' = VAR tc = [Top Profit Category] VAR gp = CALCULATE ( [Gross Profit], Products[Category] = tc ) VAR mm = ADDCOLUMNS ( ALLSELECTED ( Products[Category] ), "@m", [Gross Margin %] ) RETURN tc & " leads with " & ( VAR _g = gp RETURN SWITCH ( TRUE (), ISBLANK ( _g ), BLANK (), ABS ( _g ) >= 10000000, FORMAT ( DIVIDE ( _g, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _g ) >= 1000000, FORMAT ( DIVIDE ( _g, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _g ) >= 100000, FORMAT ( DIVIDE ( _g, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _g, "₹#,##0", "en-US" ) ) ) & " (" & FORMAT ( DIVIDE ( gp, [Gross Profit] ), "0%" ) & " of profit); margins run " & FORMAT ( MINX ( mm, [@m] ), "0%" ) & "–" & FORMAT ( MAXX ( mm, [@m] ), "0%" )
		displayFolder: 7 Titles
		lineageTag: dcff17e1-4932-4a1c-85a2-04ed09999523

	/// Gross-profit-by-category chart title.
	measure 'Title GP by Category' = VAR lo = [Lowest Profit Category] RETURN [Top Profit Category] & " earns most; " & lo & " least (" & ( VAR _l = CALCULATE ( [Gross Profit], Products[Category] = lo ) RETURN SWITCH ( TRUE (), ISBLANK ( _l ), BLANK (), ABS ( _l ) >= 10000000, FORMAT ( DIVIDE ( _l, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _l ) >= 1000000, FORMAT ( DIVIDE ( _l, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _l ) >= 100000, FORMAT ( DIVIDE ( _l, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _l, "₹#,##0", "en-US" ) ) ) & ")"
		displayFolder: 7 Titles
		lineageTag: 5d7f8093-2e68-4aef-82a5-a62c5e5dcbd6

	/// Margin-by-category chart title.
	measure 'Title Margin by Category' = VAR mm = ADDCOLUMNS ( ALLSELECTED ( Products[Category] ), "@m", [Gross Margin %] ) VAR hi = MAXX ( TOPN ( 1, mm, [@m], DESC ), Products[Category] ) VAR lo = MAXX ( TOPN ( 1, mm, [@m], ASC ), Products[Category] ) RETURN "Margin is highest in " & hi & " (" & FORMAT ( MAXX ( mm, [@m] ), "0.0%" ) & ") and thinnest in " & lo & " (" & FORMAT ( MINX ( mm, [@m] ), "0.0%" ) & ")"
		displayFolder: 7 Titles
		lineageTag: c87a8358-50ae-463d-a541-cade11c375c3

	/// Discount chart title: margin at the lowest and highest item discount.
	measure 'Title Discount' = VAR b = FILTER ( VALUES ( Order_Items[Item Discount %] ), NOT ISBLANK ( [Net Sales] ) ) VAR b0 = MINX ( b, Order_Items[Item Discount %] ) VAR b1 = MAXX ( b, Order_Items[Item Discount %] ) VAR m0 = CALCULATE ( [Gross Margin %], Order_Items[Item Discount %] = b0 ) VAR m1 = CALCULATE ( [Gross Margin %], Order_Items[Item Discount %] = b1 ) RETURN "Margin " & IF ( m1 < m0, "falls", "rises" ) & " from " & FORMAT ( m0, "0%" ) & " at " & b0 & "% item discount to " & FORMAT ( m1, "0%" ) & " at " & b1 & "%"
		displayFolder: 7 Titles
		lineageTag: 575f0b49-4cb6-4955-b90b-fc4d2d24b0ec

	/// Category P&L table title.
	measure 'Title Subcategory' = VAR ts = [Top Subcategory] RETURN "Top subcategory: " & ts & " (" & ( VAR _s = CALCULATE ( [Gross Profit], Products[Subcategory] = ts ) RETURN SWITCH ( TRUE (), ISBLANK ( _s ), BLANK (), ABS ( _s ) >= 10000000, FORMAT ( DIVIDE ( _s, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _s ) >= 1000000, FORMAT ( DIVIDE ( _s, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _s ) >= 100000, FORMAT ( DIVIDE ( _s, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _s, "₹#,##0", "en-US" ) ) ) & " gross profit)"
		displayFolder: 7 Titles
		lineageTag: b5c4754c-ff80-46fe-903a-6f105f2d7088

	/// Page 3 headline: PPAC in the latest year vs last year and target.
	measure 'Title KPI' = VAR yr = CALCULATE ( MAX ( 'Date'[Year] ), REMOVEFILTERS ( 'Date' ) ) VAR v = CALCULATE ( [Profit per Active Customer], 'Date'[Year] = yr ) VAR yoy = CALCULATE ( [Profit per Active Customer YoY %], 'Date'[Year] = yr ) VAR vt = CALCULATE ( [KPI vs Target %], 'Date'[Year] = yr ) RETURN "PPAC is " & ( VAR _p = v RETURN SWITCH ( TRUE (), ISBLANK ( _p ), BLANK (), ABS ( _p ) >= 10000000, FORMAT ( DIVIDE ( _p, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _p ) >= 1000000, FORMAT ( DIVIDE ( _p, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _p ) >= 100000, FORMAT ( DIVIDE ( _p, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _p, "₹#,##0", "en-US" ) ) ) & " in " & yr & IF ( yr = YEAR ( CALCULATE ( MAX ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) ) ) && MONTH ( CALCULATE ( MAX ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) ) ) < 12, " YTD", "" ) & ": " & FORMAT ( ABS ( yoy ), "0.0%" ) & IF ( yoy >= 0, " above", " below" ) & " last year and " & FORMAT ( ABS ( vt ), "0.0%" ) & IF ( vt >= 0, " above", " below" ) & " target"
		displayFolder: 7 Titles
		lineageTag: 6ccf0993-2fe8-4131-9866-c7e6005cedd9

	/// Quarterly PPAC chart title: quarters on target.
	measure 'Title PPAC Quarter' = VAR q = FILTER ( VALUES ( 'Date'[Year Quarter] ), NOT ISBLANK ( [Profit per Active Customer Target] ) ) VAR hit = COUNTROWS ( FILTER ( q, [Profit per Active Customer] >= [Profit per Active Customer Target] ) ) RETURN "PPAC met its target in " & hit & " of " & COUNTROWS ( q ) & " quarters that have a prior year"
		displayFolder: 7 Titles
		lineageTag: 4c8f2434-5602-4250-a62c-3fb59c57ed97

	/// Driver table title: change in each PPAC driver, latest year vs the same months last year.
	measure 'Title Drivers' = VAR yr = CALCULATE ( MAX ( 'Date'[Year] ), REMOVEFILTERS ( 'Date' ) ) VAR o = CALCULATE ( DIVIDE ( [Orders per Active Customer] - [Orders per Active Customer PY], [Orders per Active Customer PY] ), 'Date'[Year] = yr ) VAR a = CALCULATE ( DIVIDE ( [Avg Order Value] - [Avg Order Value PY], [Avg Order Value PY] ), 'Date'[Year] = yr ) VAR m = CALCULATE ( ( [Gross Margin %] - [Gross Margin % PY] ) * 100, 'Date'[Year] = yr ) RETURN "In " & yr & ", orders per customer " & IF ( o >= 0, "rose ", "fell " ) & FORMAT ( ABS ( o ), "0.0%" ) & ", order value " & IF ( a >= 0, "rose ", "fell " ) & FORMAT ( ABS ( a ), "0.0%" ) & ", margin " & IF ( m >= 0, "rose ", "fell " ) & FORMAT ( ABS ( m ), "0.0" ) & " pp"
		displayFolder: 7 Titles
		lineageTag: 99bc00d0-e9d6-471e-944d-b2ff39940f05

	/// PPAC-by-segment chart title, latest year.
	measure 'Title PPAC Segment' = VAR yr = CALCULATE ( MAX ( 'Date'[Year] ), REMOVEFILTERS ( 'Date' ) ) VAR t = ADDCOLUMNS ( FILTER ( VALUES ( Customers[Segment] ), NOT ISBLANK ( CALCULATE ( [Active Customers], 'Date'[Year] = yr ) ) ), "@p", CALCULATE ( [Profit per Active Customer], 'Date'[Year] = yr ) ) RETURN "PPAC in " & yr & IF ( yr = YEAR ( CALCULATE ( MAX ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) ) ) && MONTH ( CALCULATE ( MAX ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) ) ) < 12, " YTD", "" ) & ": " & CONCATENATEX ( t, Customers[Segment] & " " & ( VAR _p = [@p] RETURN SWITCH ( TRUE (), ISBLANK ( _p ), BLANK (), ABS ( _p ) >= 10000000, FORMAT ( DIVIDE ( _p, 10000000 ), "₹#,##0.00", "en-US" ) & " Cr", ABS ( _p ) >= 1000000, FORMAT ( DIVIDE ( _p, 100000 ), "₹#,##0.0", "en-US" ) & " L", ABS ( _p ) >= 100000, FORMAT ( DIVIDE ( _p, 100000 ), "₹#,##0.00", "en-US" ) & " L", FORMAT ( _p, "₹#,##0", "en-US" ) ) ), " vs ", [@p], DESC )
		displayFolder: 7 Titles
		lineageTag: b5491036-5f6b-4b9d-8c56-43ac4ab32e88

	/// Page 5 headline: 2026 gross profit forecast and its range for the selected scenario.
	measure 'Title Forecast' = "2026 gross profit: about " & [Card F26 Gross Profit] & " (80% range " & [Card F26 Range] & ") under scenario " & LEFT ( SELECTEDVALUE ( Scenario[Scenario], "A" ), 1 )
		displayFolder: 7 Titles
		lineageTag: 7f424dec-309d-48b9-a826-2c01ec762685

	/// Lever chart title: range of the lever sizes.
	measure 'Title Levers' = "Four levers, each worth ₹" & FORMAT ( DIVIDE ( MINX ( Levers, Levers[Uplift Low] ), 100000 ), "0.0" ) & "–" & FORMAT ( DIVIDE ( MAXX ( Levers, Levers[Uplift High] ), 100000 ), "0.0" ) & " L of 2026 gross profit"
		displayFolder: 7 Titles
		lineageTag: 7c4b5b4d-be3e-49a9-9930-5f4fe89ec185

	/// Drill-through headline for one category.
	measure 'Title Category Detail' = [Selected Category] & ": " & [Card Gross Profit] & " gross profit (" & FORMAT ( [Category Profit Share %], "0%" ) & " of total), margin " & FORMAT ( [Gross Margin %], "0.0%" ) & "; top subcategory " & [Top Subcategory]
		displayFolder: 7 Titles
		lineageTag: 8037c77b-ddf8-46dc-a295-3f3184558277

	column Hidden
		isHidden
		isAvailableInMdx: false
		lineageTag: 20229623-b95e-4d17-a52e-f7a67c74ae1d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Hidden]

		annotation SummarizationSetBy = User

	partition _Measures = calculated
		mode: import
		source = ROW ( "Hidden", BLANK () )

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["ENSURE_TABLES_HAVE_RELATIONSHIPS","REMOVE_UNNECESSARY_COLUMNS"]}

