/// Order-line fact: 1,500 lines. Amounts exclude tax and shipping; the order-level totals in the source (items_total, total_amount) repeat on every line and are not loaded.
table Order_Items
	lineageTag: 8994252e-dace-4a95-88d2-7eefaa5e0f54

	/// Units on the line.
	column Quantity
		dataType: int64
		formatString: #,##0
		lineageTag: 774168ae-5a21-46e2-b61e-4edc359e548a
		summarizeBy: none
		sourceColumn: Quantity

		annotation SummarizationSetBy = User

	/// Order line identifier.
	column 'Order Item ID'
		dataType: string
		lineageTag: eb267e95-a08c-475e-9c1f-8217a41f4c6d
		summarizeBy: none
		sourceColumn: Order Item ID

		annotation SummarizationSetBy = User

	/// Order identifier (an order has one or more lines).
	column 'Order ID'
		dataType: string
		lineageTag: 6360f158-d9cd-407a-8ea8-9934be495575
		summarizeBy: none
		sourceColumn: Order ID

		annotation SummarizationSetBy = User

	/// Order date; 23 missing dates on cancelled lines are filled from the same order.
	column 'Order Date'
		dataType: dateTime
		isHidden
		formatString: dd-mmm-yyyy
		isAvailableInMdx: false
		lineageTag: 78b3ed4c-601b-4237-810e-ebb0de9575ad
		summarizeBy: none
		sourceColumn: Order Date

		annotation SummarizationSetBy = User

	/// Customer key.
	column 'Customer ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: d9ed35db-109a-4296-b5f3-ee90498bb1d0
		summarizeBy: none
		sourceColumn: Customer ID

		annotation SummarizationSetBy = User

	/// Delivered, Shipped, Processing, Cancelled or Returned.
	column 'Order Status'
		dataType: string
		lineageTag: 4486e640-ec2f-4bd8-ac92-d34b43415d3f
		summarizeBy: none
		sourceColumn: Order Status

		annotation SummarizationSetBy = User

	/// Payment method.
	column 'Payment Method'
		dataType: string
		lineageTag: 44ea6d60-1193-45b9-92d5-a16789b79530
		summarizeBy: none
		sourceColumn: Payment Method

		annotation SummarizationSetBy = User

	/// Order-level discount in percent.
	column 'Order Discount %'
		dataType: int64
		formatString: 0
		lineageTag: f9f0a526-95d4-43ff-8c74-a291e2c42567
		summarizeBy: none
		sourceColumn: Order Discount %

		annotation SummarizationSetBy = User

	/// Product key.
	column 'Product ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 6d10e38b-7e4d-4ee0-af0b-29e65afa0a2d
		summarizeBy: none
		sourceColumn: Product ID

		annotation SummarizationSetBy = User

	/// List price per unit.
	column 'Unit Price'
		dataType: decimal
		formatString: ₹#,##0.00
		lineageTag: 54c4c12a-892c-4bb3-a6c6-591ee010082d
		summarizeBy: none
		sourceColumn: Unit Price

		annotation SummarizationSetBy = User

	/// Item-level discount in percent.
	column 'Item Discount %'
		dataType: int64
		formatString: 0
		lineageTag: a81762d9-7f18-412f-9652-74d5a9fa0fb0
		summarizeBy: none
		sourceColumn: Item Discount %

		annotation SummarizationSetBy = User

	/// Unit price x quantity, before discounts.
	column 'Gross Amount'
		dataType: decimal
		isHidden
		formatString: ₹#,##0.00
		isAvailableInMdx: false
		displayFolder: Calculated
		lineageTag: a78e17e7-6f9c-4844-8d50-229c1f0d00d7
		summarizeBy: none
		sourceColumn: Gross Amount

		annotation SummarizationSetBy = User

	/// Gross amount after item and order discounts (excl. tax and shipping).
	column 'Net Sales'
		dataType: decimal
		isHidden
		formatString: ₹#,##0.00
		isAvailableInMdx: false
		displayFolder: Calculated
		lineageTag: e3979653-5029-46c7-8c81-7f264adfd6fb
		summarizeBy: none
		sourceColumn: Net Sales

		annotation SummarizationSetBy = User

	/// Product cost price x quantity.
	column COGS
		dataType: decimal
		isHidden
		formatString: ₹#,##0.00
		isAvailableInMdx: false
		displayFolder: Calculated
		lineageTag: f8bc4809-f9de-4cd4-aed0-15baea7a1d43
		summarizeBy: none
		sourceColumn: COGS

		annotation SummarizationSetBy = User

	/// Net sales minus COGS.
	column 'Gross Profit'
		dataType: decimal
		isHidden
		formatString: ₹#,##0.00
		isAvailableInMdx: false
		displayFolder: Calculated
		lineageTag: 0b637aef-8813-404b-adcc-3d9c387524f3
		summarizeBy: none
		sourceColumn: Gross Profit

		annotation SummarizationSetBy = User

	/// FALSE for cancelled and returned orders.
	column 'Is Revenue Order'
		dataType: boolean
		displayFolder: Calculated
		lineageTag: bfe014e2-d534-4386-b59a-9c1e274bdcac
		summarizeBy: none
		sourceColumn: Is Revenue Order

		annotation SummarizationSetBy = User

	/// Fulfilled / In Progress, or Cancelled / Returned.
	column 'Order Status Group'
		dataType: string
		displayFolder: Calculated
		lineageTag: a9caea80-9989-4d27-a3f7-12cd499206a9
		summarizeBy: none
		sourceColumn: Order Status Group

		annotation SummarizationSetBy = User

	/// Item discount as a label, e.g. 10% item disc.
	column 'Item Discount Band'
		dataType: string
		displayFolder: Calculated
		lineageTag: 596ea469-7eb7-46f1-bae2-3d8314a9fbf6
		summarizeBy: none
		sourceColumn: Item Discount Band
		sortByColumn: 'Item Discount %'

		annotation SummarizationSetBy = User

	/// Order discount as a label, e.g. 5% order disc.
	column 'Order Discount Band'
		dataType: string
		displayFolder: Calculated
		lineageTag: b8a61a10-33fd-47b3-a68a-d9d4640aaf0a
		summarizeBy: none
		sourceColumn: Order Discount Band
		sortByColumn: 'Order Discount %'

		annotation SummarizationSetBy = User

	partition Order_Items = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(SourceWorkbook), null, true),
				    Sheet = Source{[Item = "Order_Items", Kind = "Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"order_item_id", type text}, {"order_id", type text}, {"order_date", type date}, {"customer_id", type text}, {"order_status", type text}, {"payment_method", type text}, {"discount_percent", Int64.Type}, {"product_id", type text}, {"quantity", Int64.Type}, {"unit_price", Currency.Type}, {"item_discount_percent", Int64.Type}}, "en-US"),
				    Kept = Table.SelectColumns(Typed, {"order_item_id", "order_id", "order_date", "customer_id", "order_status", "payment_method", "discount_percent", "product_id", "quantity", "unit_price", "item_discount_percent"}),
				    OrderDates = Table.Buffer(Table.Group(Kept, {"order_id"}, {{"__order_date", each List.Max([order_date]), type nullable date}})),
				    JoinDates = Table.NestedJoin(Kept, {"order_id"}, OrderDates, {"order_id"}, "__od", JoinKind.LeftOuter),
				    ExpDates = Table.ExpandTableColumn(JoinDates, "__od", {"__order_date"}),
				    FilledDates = Table.ReplaceValue(ExpDates, each [order_date], each if [order_date] = null then [__order_date] else [order_date], Replacer.ReplaceValue, {"order_date"}),
				    Retyped = Table.TransformColumnTypes(FilledDates, {{"order_date", type date}}),
				    Costs = Table.Buffer(Table.SelectColumns(ProductsRef, {"product_id", "cost_price"})),
				    JoinCost = Table.NestedJoin(Retyped, {"product_id"}, Costs, {"product_id"}, "__p", JoinKind.LeftOuter),
				    ExpCost = Table.ExpandTableColumn(JoinCost, "__p", {"cost_price"}),
				    Gross = Table.AddColumn(ExpCost, "Gross Amount", each [unit_price] * [quantity], Currency.Type),
				    Net = Table.AddColumn(Gross, "Net Sales", each [unit_price] * [quantity] * (1 - [item_discount_percent] / 100) * (1 - [discount_percent] / 100), Currency.Type),
				    Cogs = Table.AddColumn(Net, "COGS", each [cost_price] * [quantity], Currency.Type),
				    Profit = Table.AddColumn(Cogs, "Gross Profit", each [Net Sales] - [COGS], Currency.Type),
				    Revenue = Table.AddColumn(Profit, "Is Revenue Order", each not List.Contains({"Cancelled", "Returned"}, [order_status]), type logical),
				    StatusGroup = Table.AddColumn(Revenue, "Order Status Group", each if [Is Revenue Order] then "Fulfilled / In Progress" else "Cancelled / Returned", type text),
				    ItemBand = Table.AddColumn(StatusGroup, "Item Discount Band", each Text.From([item_discount_percent]) & "% item disc.", type text),
				    OrderBand = Table.AddColumn(ItemBand, "Order Discount Band", each Text.From([discount_percent]) & "% order disc.", type text),
				    Cleaned = Table.RemoveColumns(OrderBand, {"__order_date", "cost_price"}),
				    Renamed = Table.RenameColumns(Cleaned, {{"order_item_id", "Order Item ID"}, {"order_id", "Order ID"}, {"order_date", "Order Date"}, {"customer_id", "Customer ID"}, {"order_status", "Order Status"}, {"payment_method", "Payment Method"}, {"discount_percent", "Order Discount %"}, {"product_id", "Product ID"}, {"quantity", "Quantity"}, {"unit_price", "Unit Price"}, {"item_discount_percent", "Item Discount %"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

