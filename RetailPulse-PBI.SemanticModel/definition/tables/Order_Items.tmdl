		summarizeBy: sum
		sourceColumn: unit_price

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column item_discount_percent
		dataType: int64
		formatString: 0
		lineageTag: ff2ba4d5-ab07-43d3-b873-c43939e5a309
		summarizeBy: sum
		sourceColumn: item_discount_percent

		annotation SummarizationSetBy = Automatic

	column tax_percent
		dataType: int64
		formatString: 0
		lineageTag: a365481f-876c-4184-aa6c-97e656ba73a6
		summarizeBy: sum
		sourceColumn: tax_percent

		annotation SummarizationSetBy = Automatic

	column line_total
		dataType: double
		lineageTag: 370ea382-cd0d-4a89-a1f5-8637a28ab6d7
		summarizeBy: sum
		sourceColumn: line_total

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Gross Amount' = Order_Items[unit_price] * Order_Items[quantity]
		dataType: double
		formatString: #,##0.00
		displayFolder: Calculated
		lineageTag: 2a61376b-c2a6-45bb-a606-694661cea238

	column 'Net Sales' = Order_Items[unit_price] * Order_Items[quantity] * ( 1 - Order_Items[item_discount_percent] / 100 ) * ( 1 - Order_Items[discount_percent] / 100 )
		dataType: double
		formatString: #,##0.00
		displayFolder: Calculated
		lineageTag: 17408f37-40fb-4474-8ac1-b2a69c627123

	column COGS = RELATED ( Products[cost_price] ) * Order_Items[quantity]
		dataType: double
		formatString: #,##0.00
		displayFolder: Calculated
		lineageTag: b760a82e-1044-464f-a651-b96d52b1ae9d

	column 'Gross Profit' = Order_Items[Net Sales] - Order_Items[COGS]
		dataType: double
		formatString: #,##0.00
		displayFolder: Calculated
		lineageTag: 8c64f8a4-38fe-4318-abcc-f95df1d62491

	column 'Is Revenue Order' = NOT ( Order_Items[order_status] IN { "Cancelled", "Returned" } )
		dataType: boolean
		displayFolder: Calculated
		lineageTag: bc16877e-9a4b-4874-9daf-c841d1553539

	column 'Order Status Group' = IF ( Order_Items[Is Revenue Order], "Fulfilled / In Progress", "Cancelled / Returned" )
		dataType: string
		displayFolder: Calculated
		lineageTag: 3acc7381-eb30-4d9c-89b4-69a5c78d088d

	column 'Item Discount Band' = FORMAT ( Order_Items[item_discount_percent], "0" ) & "% item disc."
		dataType: string
		displayFolder: Calculated
		lineageTag: 884987b1-fb8f-4454-99b1-8d3f067e9824
		sortByColumn: item_discount_percent

	column 'Order Discount Band' = FORMAT ( Order_Items[discount_percent], "0" ) & "% order disc."
		dataType: string
		displayFolder: Calculated
		lineageTag: 920bae71-df31-4aea-b4b2-e3dd36e5474d
		sortByColumn: discount_percent

