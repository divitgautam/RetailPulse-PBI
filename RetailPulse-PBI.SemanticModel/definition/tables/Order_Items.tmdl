table Order_Items
	lineageTag: 74b08876-8bcd-48c1-b4a3-1e67f74f4ba0

	measure 'Total Orders' =
			
			DISTINCTCOUNTNOBLANK ( 'Order_Items'[order_id] )
		formatString: #,##0
		displayFolder: 1 Sales & Profit
		lineageTag: d895c98c-5e1b-4cf7-8ac4-42d06f734f82

