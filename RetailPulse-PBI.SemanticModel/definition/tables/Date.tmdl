/// Calendar from 1 Jan 2023 to the last order date (31 Oct 2025), so 2025 compares like-for-like with Jan-Oct 2024. Marked date table.
table Date
	lineageTag: 950cd889-a9ae-456d-9880-7f63336cd009
	dataCategory: Time

	/// Calendar date (key).
	column Date
		dataType: dateTime
		isKey
		formatString: dd-mmm-yyyy
		lineageTag: c89ee988-0c6c-47be-9f39-6ee8f831faeb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	/// Calendar year.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: ae502984-6072-4574-8634-e85326d360c2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = User

	/// Calendar quarter, Q1-Q4.
	column Quarter
		dataType: string
		lineageTag: 16387385-1f7e-4366-8e89-fc40c685abe8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = User

	/// Year and quarter, e.g. 2025 Q3.
	column 'Year Quarter'
		dataType: string
		lineageTag: 3b6c5455-5657-4d74-87e0-012b88b6f1cf
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Quarter]

		annotation SummarizationSetBy = User

	/// Month number, 1-12 (sorts Month).
	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: e3bbc9f1-8306-4b9c-9dd8-d70d98f3bda7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

		annotation SummarizationSetBy = User

	/// Month name, e.g. Jan.
	column Month
		dataType: string
		lineageTag: e3043093-aec9-4f19-ae6f-8abb6bb6b036
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month No'

		annotation SummarizationSetBy = User

	/// First day of the month.
	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 45ac4e60-f0a4-49c4-b6fe-666fe9e8dd0e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

		annotation SummarizationSetBy = User

	/// yyyymm number (sorts Year Month).
	column 'Year Month Key'
		dataType: int64
		formatString: 0
		lineageTag: 2496bbbf-cc7c-4a87-987c-3cd6a42cf738
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Key]

		annotation SummarizationSetBy = User

	/// Month label, e.g. Jan 25.
	column 'Year Month'
		dataType: string
		lineageTag: b418282b-cf80-47a8-9d06-55bcb1d5b8fb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]
		sortByColumn: 'Year Month Key'

		annotation SummarizationSetBy = User

	partition Date = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( DATE ( YEAR ( MIN ( Order_Items[Order Date] ) ), 1, 1 ), MAX ( Order_Items[Order Date] ) ), "Year", YEAR ( [Date] ), "Quarter", "Q" & QUARTER ( [Date] ), "Year Quarter", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ), "Month No", MONTH ( [Date] ), "Month", FORMAT ( [Date], "MMM" ), "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ), "Year Month", FORMAT ( [Date], "MMM yy" ), "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ) )

