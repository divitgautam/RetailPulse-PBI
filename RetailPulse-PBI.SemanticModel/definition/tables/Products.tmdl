/// Product dimension. SKU prefixes don't match categories, so SKU is not loaded.
table Products
	lineageTag: 41935c72-1d39-4072-ae58-593c119ab02a

	/// Product category (5).
	column Category
		dataType: string
		lineageTag: 04263271-fb5b-491f-beab-3188193764f8
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = User

	/// Product subcategory.
	column Subcategory
		dataType: string
		lineageTag: f8668a59-db69-470b-b666-bb42cfa87dcc
		summarizeBy: none
		sourceColumn: Subcategory

		annotation SummarizationSetBy = User

	/// Supplier name.
	column Supplier
		dataType: string
		lineageTag: e92603c5-ec27-4bde-9d89-8e60d96218e3
		summarizeBy: none
		sourceColumn: Supplier

		annotation SummarizationSetBy = User

	/// Product identifier (key).
	column 'Product ID'
		dataType: string
		isKey
		lineageTag: 68ca9f3b-d733-4725-aa1e-183dd5c054d3
		summarizeBy: none
		sourceColumn: Product ID

		annotation SummarizationSetBy = User

	/// Product name.
	column 'Product Name'
		dataType: string
		lineageTag: fab27326-3ad3-4c71-9391-07739a09ec94
		summarizeBy: none
		sourceColumn: Product Name

		annotation SummarizationSetBy = User

	partition Products = m
		mode: import
		source =
				let
				    Source = ProductsRef,
				    Kept = Table.SelectColumns(Source, {"product_id", "product_name", "category", "subcategory", "supplier"}),
				    Renamed = Table.RenameColumns(Kept, {{"product_id", "Product ID"}, {"product_name", "Product Name"}, {"category", "Category"}, {"subcategory", "Subcategory"}, {"supplier", "Supplier"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

