/// Shared scenario list so one slicer filters both forecast tables.
table Scenario
	lineageTag: dc608d1b-e3c2-4680-b6b9-b191b7a13a09

	/// Acquisition scenario: A no new sign-ups, B sign-ups resume, C activation push.
	column Scenario
		dataType: string
		isKey
		lineageTag: a3d3d050-5122-4e97-b463-6d534e731da6
		summarizeBy: none
		isNameInferred
		sourceColumn: [Scenario]

		annotation SummarizationSetBy = User

	partition Scenario = calculated
		mode: import
		source = DISTINCT ( SELECTCOLUMNS ( 'Forecast 2026', "Scenario", 'Forecast 2026'[Scenario] ) )

