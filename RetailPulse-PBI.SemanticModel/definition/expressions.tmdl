expression SourceWorkbook = "C:\Users\hp\Downloads\Online Sales Data.xlsx" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 60254cea-df40-49ed-9d5e-1556253dc954

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

/// Products sheet as typed (not loaded): feeds the Products table and the cost price in Order_Items.
expression ProductsRef =
		let
		    Source = Excel.Workbook(File.Contents(SourceWorkbook), null, true),
		    Sheet = Source{[Item = "Products", Kind = "Sheet"]}[Data],
		    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(Promoted, {{"product_id", type text}, {"sku", type text}, {"product_name", type text}, {"category", type text}, {"subcategory", type text}, {"unit_price", Currency.Type}, {"cost_price", Currency.Type}, {"supplier", type text}, {"stock_quantity", Int64.Type}}, "en-US")
		in
		    Typed
	lineageTag: 925b513b-9338-4693-a284-fae3fc506579

	annotation PBI_ResultType = Table

