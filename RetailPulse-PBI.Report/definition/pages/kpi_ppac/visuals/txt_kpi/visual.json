                "textRuns": [
                  {
                    "value": "Why this KPI",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#020618",
                      "fontFamily": "'Instrument Sans', 'Segoe UI Semibold', sans-serif"
