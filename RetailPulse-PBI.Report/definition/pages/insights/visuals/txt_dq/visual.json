                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "SKU prefixes do not match categories ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#F05100"
                    }
                  },
                  {
                    "value": "(for example Fashion products with BE- SKUs). Do not use SKU to infer category.",
