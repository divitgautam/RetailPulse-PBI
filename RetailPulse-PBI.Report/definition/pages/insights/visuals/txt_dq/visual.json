              },
              {
                "textRuns": [
                  {
                    "value": "Relationship fixed. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#F05100"
                    }
                  },
                  {
                    "value": "Customers to Order_Items was many-to-many and bi-directional. It is now one-to-many, single direction.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#020618"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Do not sum items_total or total_amount. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#F05100"
                    }
                  },
                  {
                    "value": "They are order-level values repeated on every line; summing them overstates sales about 4.6x. Use the Net Sales and Gross Profit measures.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#020618"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Profit definition. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#F05100"
                    }
                  },
                  {
                    "value": "Net sales = unit price x qty x (1 - item discount) x (1 - order discount), excluding tax and shipping. COGS = cost price x qty. Cancelled and returned orders are excluded.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#020618"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
