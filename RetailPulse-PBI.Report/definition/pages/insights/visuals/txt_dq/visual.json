                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Missing order dates filled. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#F05100"
                    }
                  },
                  {
                    "value": "23 cancelled lines had no order_date; each is filled from the other lines of the same order.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#020618"
